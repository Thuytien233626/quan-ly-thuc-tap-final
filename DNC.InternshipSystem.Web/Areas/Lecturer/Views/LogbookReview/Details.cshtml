@using DNC.InternshipSystem.Core.Entities
@model List<Logbook>
@{
    Layout = "~/Areas/Lecturer/Views/Shared/_LayoutLecturer.cshtml";
    ViewData["Title"] = "Chi tiết nhật ký";
    var registration = ViewBag.Registration as Registration;
    var student = registration?.Student;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Chi tiết nhật ký thực tập</h4>
        <p class="text-muted mb-0 small">
            Sinh viên: <strong>@(student?.User?.FullName ?? "N/A")</strong> - 
            MSSV: <strong>@(student?.StudentCode ?? "N/A")</strong>
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Trở về
    </a>
</div>

<!-- Logbook List -->
<div class="row g-4">
    <div class="col-lg-8">
        @if (Model != null && Model.Any())
        {
            @foreach (var log in Model)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-primary rounded-pill px-3">Tuần @log.WeekNumber</span>
                            <small class="text-muted">
                                @log.StartDate.ToString("dd/MM/yyyy") - @log.EndDate.ToString("dd/MM/yyyy")
                            </small>
                        </div>
                        <div>
                            @if (!string.IsNullOrEmpty(log.LecturerComment))
                            {
                                <span class="badge bg-success-subtle text-success"><i class="fa fa-check me-1"></i> Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning"><i class="fa fa-clock me-1"></i> Chờ duyệt</span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <h6 class="fw-bold text-dark mb-2">Nội dung công việc:</h6>
                        <div class="bg-light p-3 rounded mb-3" style="white-space: pre-wrap;">@log.Content</div>
                        
                        @if (!string.IsNullOrEmpty(log.EvidenceImageUrl))
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Minh chứng:</small>
                                <a href="@log.EvidenceImageUrl" target="_blank" class="text-primary text-decoration-underline">
                                    <i class="fa fa-paperclip me-1"></i> Xem file đính kèm
                                </a>
                            </div>
                        }

                        <hr class="my-3">
                        
                        <div class="lecturer-comment-section" id="comment-section-@log.Id">
                            <h6 class="fw-bold text-dark mb-2">Nhận xét của giảng viên:</h6>
                            @if (!string.IsNullOrEmpty(log.LecturerComment))
                            {
                                <div class="bg-primary bg-opacity-10 p-3 rounded border border-primary-subtle text-dark">
                                    @log.LecturerComment
                                </div>
                                <button class="btn btn-sm btn-link text-muted mt-1 px-0" onclick="enableEdit('@log.Id')">
                                    <i class="fa fa-edit me-1"></i> Chỉnh sửa
                                </button>
                            }
                            
                            <div id="comment-form-@log.Id" class="@(!string.IsNullOrEmpty(log.LecturerComment) ? "d-none" : "")">
                                <textarea class="form-control mb-2" id="comment-input-@log.Id" rows="2" 
                                          placeholder="Nhập nhận xét của bạn...">@(log.LecturerComment)</textarea>
                                <div class="d-flex justify-content-between">
                                    <button class="btn btn-outline-warning btn-sm" onclick="requestResubmit('@log.Id')">
                                        <i class="fa fa-undo me-1"></i> Trả lại sửa
                                    </button>
                                    <button class="btn btn-primary btn-sm" onclick="saveComment('@log.Id')">
                                        <i class="fa fa-save me-1"></i> Lưu nhận xét
                                    </button>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- AI Mentor Section -->
                        <div class="ai-mentor-section" id="ai-section-@log.Id">
                            <h6 class="fw-bold text-dark mb-2">
                                <i class="fa fa-brain text-info me-2"></i> AI Mentor Phân Tích
                            </h6>
                                                    @if (!string.IsNullOrEmpty(log.AISummary))
                        {
                            <div class="card border-info mb-3">
                                <div class="card-header bg-info bg-opacity-10 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-info"><i class="fa fa-robot me-1"></i> Kết quả phân tích</span>
                                    <span class="badge @(log.AiScore >= 80 ? "bg-success" : log.AiScore >= 50 ? "bg-warning" : "bg-danger") fs-6">
                                        Điểm: @log.AiScore / 100
                                    </span>
                                </div>
                                <div class="card-body">
                                    @if (log.AIWarning)
                                    {
                                        <div class="alert alert-danger py-2 mb-3">
                                            <strong><i class="fa fa-exclamation-triangle me-1"></i> Cảnh báo:</strong> @log.AIWarningDetails
                                        </div>
                                    }
                                    
                                    <p class="mb-2"><strong>Tóm tắt:</strong> @log.AISummary</p>
                                    
                                    @if (!string.IsNullOrEmpty(log.AiSuggestions))
                                    {
                                        <div class="bg-light p-2 rounded mt-3">
                                            <strong>Gợi ý cải thiện:</strong><br/>
                                            <div style="white-space: pre-line;">@log.AiSuggestions</div>
                                        </div>
                                    }
                                </div>
                            </div>
                            
                            <button class="btn btn-sm btn-outline-info mt-2" onclick="analyzeWithAI('@log.Id')">
                                <i class="fa fa-sync me-1"></i> Phân tích lại
                            </button>
                        }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/empty-state-2130362-1800926.png" 
                     alt="Empty" style="width: 150px; opacity: 0.5;" class="mb-3">
                <p class="text-muted">Sinh viên chưa nộp nhật ký nào.</p>
            </div>
        }
    </div>

    <!-- Sidebar Info -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">Thông tin thực tập</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Đơn vị thực tập</small>
                    <div class="fw-semibold">@(registration?.Company?.Name ?? registration?.ExternalCompanyName ?? "N/A")</div>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Vị trí</small>
                    <div class="fw-semibold">@(registration?.Position ?? "N/A")</div>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Thời gian</small>
                    <div>@(registration?.Term?.InternshipStart.ToString("dd/MM/yyyy") ?? "N/A") - @(registration?.Term?.EndDate.ToString("dd/MM/yyyy") ?? "N/A")</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form id="antiforgery-form">
        @Html.AntiForgeryToken()
    </form>

    <script>
        // Hàm dùng chung để lấy Token
        function getAntiForgeryToken() {
            return document.querySelector('#antiforgery-form input[name="__RequestVerificationToken"]').value;
        }

        function enableEdit(logId) {
            document.getElementById(`comment-form-${logId}`).classList.remove('d-none');
        }

        function saveComment(logId) {
            const content = document.getElementById(`comment-input-${logId}`).value;
            if (!content.trim()) {
                Swal.fire('Lỗi', 'Vui lòng nhập nội dung nhận xét', 'error');
                return;
            }

            // 2. Thêm Token vào data gửi đi
            $.post('@Url.Action("AddComment", "LogbookReview")', { 
                logbookId: logId, 
                comment: content,
                __RequestVerificationToken: getAntiForgeryToken() 
            }, function(res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: res.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', 'Không thể lưu nhận xét', 'error');
                }
            }).fail(function() {
                Swal.fire('Lỗi', 'Lỗi kết nối server', 'error');
            });
        }

        function analyzeWithAI(logId) {
            const btn = document.getElementById(`btn-analyze-${logId}`) || document.querySelector(`button[onclick="analyzeWithAI('${logId}')"]`);
            const loading = document.getElementById(`loading-${logId}`);
            const retryInfo = document.getElementById(`retry-info-${logId}`);
            
            if (btn) btn.disabled = true;
            if (loading) loading.classList.remove('d-none');
            if (retryInfo) retryInfo.classList.add('d-none');

            // 3. Thêm Token vào payload của AJAX
            $.ajax({
                url: '@Url.Action("AnalyzeWithAI", "LogbookReview")',
                type: 'POST',
                data: { 
                    logbookId: logId,
                    __RequestVerificationToken: getAntiForgeryToken()
                },
                timeout: 60000, 
                success: function(res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Phân tích thành công',
                            text: res.message,
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => location.reload());
                    } else {
                        Swal.fire('Lỗi', res.message || 'Không thể phân tích logbook', 'error');
                        if (btn) btn.disabled = false;
                        if (loading) loading.classList.add('d-none');
                    }
                },
                error: function(xhr) {
                    let errorMsg = 'Lỗi kết nối server';
                    let icon = 'error';
                    
                    if (xhr.status === 0) {
                        errorMsg = 'Kết nối bị mất. Vui lòng kiểm tra internet.';
                    } else if (xhr.status === 408 || xhr.statusText === 'timeout') {
                        errorMsg = 'Thời gian chờ quá lâu. Vui lòng thử lại.';
                        icon = 'warning';
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    } else if (xhr.status >= 500) {
                        errorMsg = 'Lỗi server backend. Hãy kiểm tra Console/Log IDE.';
                    } else if (xhr.status === 400) {
                        errorMsg = 'Lỗi bảo mật dữ liệu (Bad Request).';
                    }
                    
                    Swal.fire('Lỗi', errorMsg, icon);
                    if (btn) btn.disabled = false;
                    if (loading) loading.classList.add('d-none');
                }
            });
        }

        async function requestResubmit(logId) {
            const { value: reason } = await Swal.fire({
                title: '<i class="fa fa-undo text-warning me-2"></i>Trả nhật ký về cho sinh viên',
                html: '<p class="text-muted">Nhập lý do yêu cầu sinh viên sửa lại:</p>',
                input: 'textarea',
                inputPlaceholder: 'VD: Nội dung quá ngắn, cần bổ sung chi tiết công việc...',
                inputAttributes: { rows: 3 },
                showCancelButton: true,
                confirmButtonText: '<i class="fa fa-undo me-1"></i>Trả lại',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#ffc107',
                inputValidator: (value) => {
                    if (!value || !value.trim()) return 'Vui lòng nhập lý do!';
                }
            });

            if (!reason) return;

            $.post('@Url.Action("RequestResubmit", "LogbookReview")', {
                logbookId: logId,
                reason: reason,
                __RequestVerificationToken: getAntiForgeryToken()
            }, function(res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã trả lại',
                        text: res.message,
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', res.message || 'Không thể trả lại', 'error');
                }
            }).fail(function() {
                Swal.fire('Lỗi', 'Lỗi kết nối server', 'error');
            });
        }
    </script>
}