@using DNC.InternshipSystem.Core.Entities
@model List<Logbook>
@{
    Layout = "~/Areas/Lecturer/Views/Shared/_LayoutLecturer.cshtml";
    ViewData["Title"] = "Chi tiết nhật ký";
    var registration = ViewBag.Registration as Registration;
    var student = registration?.Student;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Chi tiết nhật ký thực tập</h4>
        <p class="text-muted mb-0 small">
            Sinh viên: <strong>@(student?.User?.FullName ?? "N/A")</strong> - 
            MSSV: <strong>@(student?.StudentCode ?? "N/A")</strong>
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Trở về
    </a>
</div>

<!-- Logbook List -->
<div class="row g-4">
    <div class="col-lg-8">
        @if (Model != null && Model.Any())
        {
            @foreach (var log in Model)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-primary rounded-pill px-3">Tuần @log.WeekNumber</span>
                            <small class="text-muted">
                                @log.StartDate.ToString("dd/MM/yyyy") - @log.EndDate.ToString("dd/MM/yyyy")
                            </small>
                        </div>
                        <div>
                            @if (log.ResubmitRequested)
                            {
                                <span class="badge bg-warning text-dark"><i class="fa fa-exclamation-triangle me-1"></i> SV xin nộp lại</span>
                            }
                            else if (!string.IsNullOrEmpty(log.LecturerComment))
                            {
                                <span class="badge bg-success-subtle text-success"><i class="fa fa-check me-1"></i> Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning"><i class="fa fa-clock me-1"></i> Chờ duyệt</span>
                            }
                        </div>
                    </div>

                    @if (log.ResubmitRequested)
                    {
                    <div class="alert alert-warning mb-0 rounded-0 border-start-0 border-end-0 d-flex align-items-start gap-3">
                        <i class="fa fa-exclamation-circle text-warning mt-1"></i>
                        <div class="flex-grow-1">
                            <strong>Sinh viên xin nộp lại nhật ký này</strong>
                            <p class="mb-2 small text-dark">Lý do: <em>@log.ResubmitReason</em></p>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-success" onclick="approveResubmit('@log.Id', @log.WeekNumber)">
                                    <i class="fa fa-check me-1"></i> Chấp nhận
                                </button>
                                <button class="btn btn-sm btn-outline-danger" onclick="rejectResubmit('@log.Id', @log.WeekNumber)">
                                    <i class="fa fa-times me-1"></i> Từ chối
                                </button>
                            </div>
                        </div>
                    </div>
                    }

                    <div class="card-body">
                        <h6 class="fw-bold text-dark mb-2">Nội dung công việc:</h6>
                        <div class="bg-light p-3 rounded mb-3" style="white-space: pre-wrap;">@log.Content</div>
                        
                        @if (!string.IsNullOrEmpty(log.EvidenceImageUrl))
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Minh chứng:</small>
                                <a href="@log.EvidenceImageUrl" target="_blank" class="text-primary text-decoration-underline">
                                    <i class="fa fa-paperclip me-1"></i> Xem file đính kèm
                                </a>
                            </div>
                        }

                        <hr class="my-3">
                        
                        <div class="lecturer-comment-section" id="comment-section-@log.Id">
                            <h6 class="fw-bold text-dark mb-2">Nhận xét của giảng viên:</h6>
                            @if (!string.IsNullOrEmpty(log.LecturerComment))
                            {
                                <div class="bg-primary bg-opacity-10 p-3 rounded border border-primary-subtle text-dark">
                                    @log.LecturerComment
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <button class="btn btn-sm btn-link text-muted px-0" onclick="enableEdit('@log.Id')">
                                        <i class="fa fa-edit me-1"></i> Chỉnh sửa
                                    </button>
                                    <button class="btn btn-sm btn-outline-warning" onclick="requestResubmit('@log.Id', @log.WeekNumber)">
                                        <i class="fa fa-undo me-1"></i> Yêu cầu nộp lại
                                    </button>
                                </div>
                            }
                            
                            <div id="comment-form-@log.Id" class="@(!string.IsNullOrEmpty(log.LecturerComment) ? "d-none" : "")">
                                <textarea class="form-control mb-2" id="comment-input-@log.Id" rows="2" 
                                          placeholder="Nhập nhận xét của bạn...">@(log.LecturerComment)</textarea>
                                <div class="text-end">
                                    <button class="btn btn-primary btn-sm" onclick="saveComment('@log.Id')">
                                        <i class="fa fa-save me-1"></i> Lưu nhận xét
                                    </button>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- AI Mentor Section -->
                        <div class="ai-mentor-section" id="ai-section-@log.Id">
                            <h6 class="fw-bold text-dark mb-2">
                                <i class="fa fa-brain text-info me-2"></i> AI Mentor Phân Tích
                            </h6>
                            @if (!string.IsNullOrEmpty(log.AISummary))
                            {
                                <div class="bg-info bg-opacity-10 p-3 rounded border border-info-subtle text-dark mb-3">
                                    <div style="white-space: pre-wrap; font-size: 0.95rem;">@log.AISummary</div>
                                </div>
                                <button class="btn btn-sm btn-outline-info" onclick="analyzeWithAI('@log.Id')">
                                    <i class="fa fa-sync me-1"></i> Phân tích lại
                                </button>
                            }
                            else
                            {
                                <p class="text-muted mb-3">
                                    <small>Chưa phân tích. Nhấn nút bên dưới để AI Mentor phân tích logbook này.</small>
                                </p>
                                <button class="btn btn-sm btn-info" id="btn-analyze-@log.Id" onclick="analyzeWithAI('@log.Id')">
                                    <i class="fa fa-wand-magic-sparkles me-1"></i> Phân tích với AI Mentor
                                </button>
                                <div id="loading-@log.Id" class="mt-2 d-none">
                                    <div class="spinner-border spinner-border-sm text-info me-2" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <small class="text-muted">
                                        Đang phân tích... (có thể mất vài giây)
                                        <br>
                                        <span id="retry-info-@log.Id" class="d-none">Đang thử lại...</span>
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/empty-state-2130362-1800926.png" 
                     alt="Empty" style="width: 150px; opacity: 0.5;" class="mb-3">
                <p class="text-muted">Sinh viên chưa nộp nhật ký nào.</p>
            </div>
        }
    </div>

    <!-- Sidebar Info -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">Thông tin thực tập</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Đơn vị thực tập</small>
                    <div class="fw-semibold">@(registration?.Company?.Name ?? registration?.ExternalCompanyName ?? "N/A")</div>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Vị trí</small>
                    <div class="fw-semibold">@(registration?.Position ?? "N/A")</div>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Thời gian</small>
                    <div>@(registration?.Term?.InternshipStart.ToString("dd/MM/yyyy") ?? "N/A") - @(registration?.Term?.EndDate.ToString("dd/MM/yyyy") ?? "N/A")</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@Html.AntiForgeryToken()
<script>
    // Setup CSRF token cho tat ca AJAX request
    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
    $.ajaxSetup({
        beforeSend: function(xhr) {
            xhr.setRequestHeader('RequestVerificationToken', token);
        },
        headers: { 'RequestVerificationToken': token }
    });

    function enableEdit(logId) {
        document.getElementById(`comment-form-${logId}`).classList.remove('d-none');
    }

    function saveComment(logId) {
        const content = document.getElementById(`comment-input-${logId}`).value;
        if (!content.trim()) {
            Swal.fire('Lỗi', 'Vui lòng nhập nội dung nhận xét', 'error');
            return;
        }

        $.post('@Url.Action("AddComment", "LogbookReview")', {
            logbookId: logId,
            comment: content,
            __RequestVerificationToken: token
        }, function(res) {
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: res.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => location.reload());
            } else {
                Swal.fire('Lỗi', res.message || 'Không thể lưu nhận xét', 'error');
            }
        }).fail(function(xhr) {
            console.error('Save comment error:', xhr.status, xhr.responseText);
            Swal.fire('Lỗi', 'Lỗi kết nối server (HTTP ' + xhr.status + ')', 'error');
        });
    }

    function analyzeWithAI(logId) {
        const btn = document.getElementById(`btn-analyze-${logId}`);
        const loading = document.getElementById(`loading-${logId}`);
        const retryInfo = document.getElementById(`retry-info-${logId}`);
        
        if (btn) btn.disabled = true;
        if (loading) loading.classList.remove('d-none');
        if (retryInfo) retryInfo.classList.add('d-none');

        $.ajax({
            url: '@Url.Action("AnalyzeWithAI", "LogbookReview")',
            type: 'POST',
            data: { logbookId: logId, __RequestVerificationToken: token },
            timeout: 60000,
            success: function(res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Phân tích thành công',
                        text: res.message,
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    Swal.fire('Lỗi', res.message || 'Không thể phân tích logbook', 'error');
                    if (btn) btn.disabled = false;
                    if (loading) loading.classList.add('d-none');
                }
            },
            error: function(xhr) {
                let errorMsg = 'Lỗi kết nối server';
                let icon = 'error';
                
                if (xhr.status === 0) {
                    errorMsg = 'Kết nối bị mất. Vui lòng kiểm tra internet.';
                } else if (xhr.status === 408 || xhr.statusText === 'timeout') {
                    errorMsg = 'Thời gian chờ quá lâu. Vui lòng thử lại.';
                    icon = 'warning';
                } else if (xhr.responseJSON && xhr.responseJSON.message) {
                    errorMsg = xhr.responseJSON.message;
                } else if (xhr.status >= 500) {
                    errorMsg = 'Lỗi server. Vui lòng thử lại sau.';
                }
                
                Swal.fire('Lỗi', errorMsg, icon);
                if (btn) btn.disabled = false;
                if (loading) loading.classList.add('d-none');
            }
        });
    }

    function requestResubmit(logId, weekNumber) {
        Swal.fire({
            title: 'Yêu cầu nộp lại',
            html: '<p>Yêu cầu sinh viên nộp lại nhật ký <strong>Tuần ' + weekNumber + '</strong>.</p>' +
                  '<p class="text-muted small mb-2">Nhận xét hiện tại sẽ bị xóa, sinh viên có thể chỉnh sửa và nộp lại.</p>',
            input: 'textarea',
            inputLabel: 'Lý do yêu cầu nộp lại',
            inputPlaceholder: 'VD: Nội dung quá sơ sài, cần bổ sung chi tiết...',
            inputAttributes: { 'aria-label': 'Lý do' },
            showCancelButton: true,
            confirmButtonText: '<i class="fa fa-undo me-1"></i> Xác nhận',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#f59e0b',
            inputValidator: (value) => {
                if (!value) return 'Vui lòng nhập lý do yêu cầu nộp lại.';
            }
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('@Url.Action("RequestResubmit", "LogbookReview")', {
                    logbookId: logId,
                    reason: result.value,
                    __RequestVerificationToken: token
                }, function(res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: res.message,
                            timer: 1500,
                            showConfirmButton: false
                        }).then(() => location.reload());
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                }).fail(function(xhr) {
                    Swal.fire('Lỗi', 'Lỗi kết nối server (HTTP ' + xhr.status + ')', 'error');
                });
            }
        });
    }

    function approveResubmit(logId, weekNumber) {
        Swal.fire({
            title: 'Chấp nhận nộp lại?',
            html: 'Cho phép sinh viên nộp lại nhật ký <strong>Tuần ' + weekNumber + '</strong>?<br><small class="text-muted">Nhận xét hiện tại sẽ bị xóa.</small>',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: '<i class="fa fa-check me-1"></i> Chấp nhận',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#198754'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('@Url.Action("ApproveResubmit", "LogbookReview")', {
                    logbookId: logId,
                    __RequestVerificationToken: token
                }, function(res) {
                    if (res.success) {
                        Swal.fire({ icon: 'success', title: 'Đã chấp nhận', text: res.message, timer: 1500, showConfirmButton: false })
                            .then(() => location.reload());
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                }).fail(function(xhr) {
                    Swal.fire('Lỗi', 'Lỗi server (HTTP ' + xhr.status + ')', 'error');
                });
            }
        });
    }

    function rejectResubmit(logId, weekNumber) {
        Swal.fire({
            title: 'Từ chối nộp lại?',
            html: 'Từ chối yêu cầu nộp lại nhật ký <strong>Tuần ' + weekNumber + '</strong>?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '<i class="fa fa-times me-1"></i> Từ chối',
            cancelButtonText: 'Hủy',
            confirmButtonColor: '#dc3545'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('@Url.Action("RejectResubmit", "LogbookReview")', {
                    logbookId: logId,
                    __RequestVerificationToken: token
                }, function(res) {
                    if (res.success) {
                        Swal.fire({ icon: 'info', title: 'Đã từ chối', text: res.message, timer: 1500, showConfirmButton: false })
                            .then(() => location.reload());
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                }).fail(function(xhr) {
                    Swal.fire('Lỗi', 'Lỗi server (HTTP ' + xhr.status + ')', 'error');
                });
            }
        });
    }
</script>
}

