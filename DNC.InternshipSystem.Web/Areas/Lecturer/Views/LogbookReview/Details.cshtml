@using DNC.InternshipSystem.Core.Entities
@model List<Logbook>
@{
    Layout = "~/Areas/Lecturer/Views/Shared/_LayoutLecturer.cshtml";
    ViewData["Title"] = "Chi tiết nhật ký";
    var registration = ViewBag.Registration as Registration;
    var student = registration?.Student;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Chi tiết nhật ký thực tập</h4>
        <p class="text-muted mb-0 small">
            Sinh viên: <strong>@(student?.User?.FullName ?? "N/A")</strong> - 
            MSSV: <strong>@(student?.StudentCode ?? "N/A")</strong>
        </p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Trở về
    </a>
</div>

<!-- Logbook List -->
<div class="row g-4">
    <div class="col-lg-8">
        @if (Model != null && Model.Any())
        {
            @foreach (var log in Model)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-primary rounded-pill px-3">Tuần @log.WeekNumber</span>
                            <small class="text-muted">
                                @log.StartDate.ToString("dd/MM/yyyy") - @log.EndDate.ToString("dd/MM/yyyy")
                            </small>
                        </div>
                        <div>
                            @if (!string.IsNullOrEmpty(log.LecturerComment))
                            {
                                <span class="badge bg-success-subtle text-success"><i class="fa fa-check me-1"></i> Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning"><i class="fa fa-clock me-1"></i> Chờ duyệt</span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <h6 class="fw-bold text-dark mb-2">Nội dung công việc:</h6>
                        <div class="bg-light p-3 rounded mb-3" style="white-space: pre-wrap;">@log.Content</div>
                        
                        @if (!string.IsNullOrEmpty(log.EvidenceImageUrl))
                        {
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1">Minh chứng:</small>
                                <a href="@log.EvidenceImageUrl" target="_blank" class="text-primary text-decoration-underline">
                                    <i class="fa fa-paperclip me-1"></i> Xem file đính kèm
                                </a>
                            </div>
                        }

                        <hr class="my-3">
                        
                        <div class="lecturer-comment-section" id="comment-section-@log.Id">
                            <h6 class="fw-bold text-dark mb-2">Nhận xét của giảng viên:</h6>
                            @if (!string.IsNullOrEmpty(log.LecturerComment))
                            {
                                <div class="bg-primary bg-opacity-10 p-3 rounded border border-primary-subtle text-dark">
                                    @log.LecturerComment
                                </div>
                                <button class="btn btn-sm btn-link text-muted mt-1 px-0" onclick="enableEdit('@log.Id')">
                                    <i class="fa fa-edit me-1"></i> Chỉnh sửa
                                </button>
                            }
                            
                            <div id="comment-form-@log.Id" class="@(!string.IsNullOrEmpty(log.LecturerComment) ? "d-none" : "")">
                                <textarea class="form-control mb-2" id="comment-input-@log.Id" rows="2" 
                                          placeholder="Nhập nhận xét của bạn...">@(log.LecturerComment)</textarea>
                                <div class="text-end">
                                    <button class="btn btn-primary btn-sm" onclick="saveComment('@log.Id')">
                                        <i class="fa fa-save me-1"></i> Lưu nhận xét
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/empty-state-2130362-1800926.png" 
                     alt="Empty" style="width: 150px; opacity: 0.5;" class="mb-3">
                <p class="text-muted">Sinh viên chưa nộp nhật ký nào.</p>
            </div>
        }
    </div>

    <!-- Sidebar Info -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">Thông tin thực tập</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Đơn vị thực tập</small>
                    <div class="fw-semibold">@(registration?.Company?.Name ?? registration?.ExternalCompanyName ?? "N/A")</div>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Vị trí</small>
                    <div class="fw-semibold">@(registration?.Position ?? "N/A")</div>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Thời gian</small>
                    <div>@(registration?.Term?.InternshipStart.ToString("dd/MM/yyyy") ?? "N/A") - @(registration?.Term?.EndDate.ToString("dd/MM/yyyy") ?? "N/A")</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function enableEdit(logId) {
        document.getElementById(`comment-form-${logId}`).classList.remove('d-none');
    }

    function saveComment(logId) {
        const content = document.getElementById(`comment-input-${logId}`).value;
        if (!content.trim()) {
            Swal.fire('Lỗi', 'Vui lòng nhập nội dung nhận xét', 'error');
            return;
        }

        $.post('@Url.Action("AddComment", "LogbookReview")', { logbookId: logId, comment: content }, function(res) {
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công',
                    text: res.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => location.reload()); // Reload de cap nhat UI
            } else {
                Swal.fire('Lỗi', 'Không thể lưu nhận xét', 'error');
            }
        }).fail(function() {
            Swal.fire('Lỗi', 'Lỗi kết nối server', 'error');
        });
    }
</script>
}
