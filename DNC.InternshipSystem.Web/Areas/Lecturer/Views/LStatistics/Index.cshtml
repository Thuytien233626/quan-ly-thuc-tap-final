@{
    Layout = "~/Areas/Lecturer/Views/Shared/_LayoutLecturer.cshtml";
    ViewData["Title"] = "Thống kê & Báo cáo";

    int totalStudentsInClasses = ViewBag.TotalStudentsInClasses ?? 0;
    int totalStudents = ViewBag.TotalStudents ?? 0;
    int gradedCount = ViewBag.GradedCount ?? 0;
    int pendingGrading = ViewBag.PendingGrading ?? 0;
    int totalLogbooks = ViewBag.TotalLogbooks ?? 0;
    int reviewedLogbooks = ViewBag.ReviewedLogbooks ?? 0;
    int pendingLogbooks = totalLogbooks - reviewedLogbooks;
    int[] scoreDistribution = ViewBag.ScoreDistribution ?? new int[5];
    var companyGroups = ViewBag.CompanyGroups as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    
    int gradedPercent = totalStudents > 0 ? (int)Math.Round((double)gradedCount / totalStudents * 100) : 0;
    int logbookPercent = totalLogbooks > 0 ? (int)Math.Round((double)reviewedLogbooks / totalLogbooks * 100) : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Thống kê & Báo cáo</h4>
        <p class="text-muted mb-0 small">Tổng hợp số liệu hướng dẫn thực tập của bạn.</p>
    </div>
</div>

<!-- Tong quan nhanh -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-4">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                    <i class="fa fa-users fs-4"></i>
                </div>
                <h3 class="fw-bold mb-1">@totalStudentsInClasses</h3>
                <small class="text-muted">Sinh viên phụ trách</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-4">
                <div class="rounded-circle bg-success bg-opacity-10 text-success mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                    <i class="fa fa-check-circle fs-4"></i>
                </div>
                <h3 class="fw-bold mb-1 text-success">@gradedCount</h3>
                <small class="text-muted">Đã chấm điểm</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-4">
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                    <i class="fa fa-hourglass-half fs-4"></i>
                </div>
                <h3 class="fw-bold mb-1 text-warning">@pendingGrading</h3>
                <small class="text-muted">Chưa chấm điểm</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center py-4">
                <div class="rounded-circle bg-info bg-opacity-10 text-info mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                    <i class="fa fa-book fs-4"></i>
                </div>
                <h3 class="fw-bold mb-1 text-info">@totalLogbooks</h3>
                <small class="text-muted">Tổng nhật ký nhận được</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Tien do cham diem -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="fa fa-clipboard-check text-primary me-2"></i>Tiến độ chấm điểm</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Hoàn thành</span>
                    <span class="fw-bold">@gradedPercent%</span>
                </div>
                <div class="progress mb-4" style="height: 10px;">
                    <div class="progress-bar bg-primary" style="width: @gradedPercent%; transition: width 1s ease;"></div>
                </div>

                <div class="row text-center">
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <h4 class="fw-bold text-success mb-0">@gradedCount</h4>
                            <small class="text-muted">Đã chấm</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <h4 class="fw-bold text-danger mb-0">@pendingGrading</h4>
                            <small class="text-muted">Chưa chấm</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tien do duyet nhat ky -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="fa fa-book-reader text-warning me-2"></i>Tiến độ duyệt nhật ký</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small">Đã duyệt</span>
                    <span class="fw-bold">@logbookPercent%</span>
                </div>
                <div class="progress mb-4" style="height: 10px;">
                    <div class="progress-bar bg-warning" style="width: @logbookPercent%; transition: width 1s ease;"></div>
                </div>

                <div class="row text-center">
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <h4 class="fw-bold text-success mb-0">@reviewedLogbooks</h4>
                            <small class="text-muted">Đã duyệt</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <h4 class="fw-bold text-warning mb-0">@pendingLogbooks</h4>
                            <small class="text-muted">Chưa duyệt</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Phan bo diem & Doanh nghiep -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="fa fa-chart-bar text-info me-2"></i>Phân bố điểm GVHD</h6>
            </div>
            <div class="card-body">
                @{
                    string[] labels = { "0 - 2", "2 - 4", "4 - 6", "6 - 8", "8 - 10" };
                    string[] colors = { "#ef4444", "#f97316", "#eab308", "#22c55e", "#3b82f6" };
                    int maxScore = scoreDistribution.Max() > 0 ? scoreDistribution.Max() : 1;
                }
                @for (int i = 0; i < 5; i++)
                {
                    int percent = (int)Math.Round((double)scoreDistribution[i] / maxScore * 100);
                    <div class="d-flex align-items-center mb-3">
                        <span class="text-muted small me-3" style="min-width: 50px;">@labels[i]</span>
                        <div class="flex-grow-1">
                            <div class="progress" style="height: 24px;">
                                <div class="progress-bar" style="width: @percent%; background-color: @colors[i]; transition: width 1s ease;">
                                    @if (scoreDistribution[i] > 0)
                                    {
                                        <span class="small fw-bold">@scoreDistribution[i] SV</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                @if (scoreDistribution.All(s => s == 0))
                {
                    <div class="text-center py-3 text-muted">
                        <i class="fa fa-chart-bar fa-2x mb-2 opacity-25"></i>
                        <p class="mb-0 small">Chưa có dữ liệu điểm.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="fa fa-building text-success me-2"></i>Sinh viên theo Doanh nghiệp</h6>
            </div>
            <div class="card-body">
                @if (companyGroups.Any())
                {
                    @foreach (var item in companyGroups)
                    {
                        int cPercent = totalStudents > 0 ? (int)Math.Round((double)item.Count / totalStudents * 100) : 0;
                        <div class="d-flex align-items-center mb-3">
                            <div class="flex-grow-1 me-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-semibold text-truncate" style="max-width: 200px;" title="@item.Company">@item.Company</span>
                                    <span class="small text-muted">@item.Count SV</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" style="width: @cPercent%; transition: width 1s ease;"></div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <i class="fa fa-building fa-2x mb-2 opacity-25"></i>
                        <p class="mb-0 small">Chưa có dữ liệu phân bố.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
