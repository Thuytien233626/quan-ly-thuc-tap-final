@using DNC.InternshipSystem.Core.Entities
@{
    Layout = "~/Areas/Lecturer/Views/Shared/_LayoutLecturer.cshtml";
    ViewData["Title"] = "Danh sách sinh viên";

    var myClasses = ViewBag.MyClasses as List<Class> ?? new List<Class>();
    var studentCounts = ViewBag.StudentCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    int totalStudents = studentCounts.Values.Sum();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Sinh viên hướng dẫn</h4>
        <p class="text-muted mb-0 small">Chọn lớp để xem danh sách sinh viên.</p>
    </div>
    <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25 px-3 py-2 fs-6">
        @totalStudents sinh viên
    </span>
</div>

@if (!myClasses.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="fa fa-chalkboard fa-3x mb-3 opacity-25"></i>
            <h5 class="mb-2">Chưa được phân công lớp nào</h5>
            <p class="mb-0 small">Vui lòng liên hệ admin để được phân công lớp hướng dẫn.</p>
        </div>
    </div>
}
else
{
    <!-- Lop phu trach -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <span class="text-muted me-2">
                    <i class="fa fa-chalkboard me-1"></i> Lớp phụ trách:
                </span>
                @foreach (var cls in myClasses)
                {
                    var count = studentCounts.ContainsKey(cls.Id) ? studentCounts[cls.Id] : 0;
                    <button class="btn btn-outline-info btn-sm class-tab px-3 py-1 rounded-pill fw-semibold"
                            data-class-id="@cls.Id" data-class-name="@cls.Name"
                            onclick="loadClassStudents('@cls.Id', '@cls.Name', @count)">
                        @cls.Id
                        <span class="badge bg-info text-white ms-1">@count SV</span>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Placeholder khi chua chon lop -->
    <div id="noClassSelected" class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="fa fa-hand-pointer fa-3x mb-3 opacity-25"></i>
            <h5 class="mb-2">Chọn một lớp để xem danh sách</h5>
            <p class="mb-0 small">Bấm vào tên lớp phía trên để hiển thị sinh viên trong lớp đó.</p>
        </div>
    </div>

    <!-- Danh sach sinh vien (AJAX load) -->
    <div id="studentListContainer" class="card border-0 shadow-sm" style="display:none;">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0">
                <i class="fa fa-users text-primary me-2"></i>
                <span id="selectedClassName">—</span>
                <span id="selectedClassCount" class="badge bg-light text-dark border ms-2"></span>
            </h6>
            <div class="d-flex gap-2 align-items-center">
                <div class="input-group input-group-sm" style="width: 260px;">
                    <span class="input-group-text bg-white border-end-0"><i class="fa fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Tìm theo tên hoặc MSSV..." oninput="filterStudents()">
                </div>
            </div>
        </div>
        <div id="studentListBody" class="card-body p-0">
            <!-- AJAX content loaded here -->
        </div>
    </div>
}

@section Scripts {
<script>
    let currentClassId = null;
    let currentClassName = null;
    let currentCount = 0;

    async function loadClassStudents(classId, className, count, page) {
        page = page || 1;

        // Highlight active tab
        document.querySelectorAll('.class-tab').forEach(t => {
            t.classList.remove('btn-info', 'text-white');
            t.classList.add('btn-outline-info');
        });
        const activeBtn = document.querySelector(`.class-tab[data-class-id="${classId}"]`);
        if (activeBtn) {
            activeBtn.classList.remove('btn-outline-info');
            activeBtn.classList.add('btn-info', 'text-white');
        }

        currentClassId = classId;
        currentClassName = className;
        currentCount = count;

        // Update header
        document.getElementById('selectedClassName').textContent = 'Lớp ' + classId;
        document.getElementById('selectedClassCount').textContent = count + ' sinh viên';
        document.getElementById('searchInput').value = '';

        // Show container, hide placeholder
        document.getElementById('noClassSelected').style.display = 'none';
        document.getElementById('studentListContainer').style.display = 'block';

        // Loading state
        document.getElementById('studentListBody').innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2 small">Đang tải danh sách...</p>
            </div>`;

        try {
            const res = await fetch(`/Lecturer/MyStudents/GetStudentsByClass?classId=${encodeURIComponent(classId)}&page=${page}`);
            if (res.ok) {
                document.getElementById('studentListBody').innerHTML = await res.text();
            } else {
                document.getElementById('studentListBody').innerHTML = `
                    <div class="text-center py-5 text-danger">
                        <i class="fa fa-exclamation-circle fa-2x mb-2"></i>
                        <p>Không thể tải danh sách sinh viên.</p>
                    </div>`;
            }
        } catch (e) {
            document.getElementById('studentListBody').innerHTML = `
                <div class="text-center py-5 text-danger">
                    <i class="fa fa-exclamation-circle fa-2x mb-2"></i>
                    <p>Lỗi kết nối: ${e.message}</p>
                </div>`;
        }
    }

    function goToPage(page) {
        if (currentClassId) {
            loadClassStudents(currentClassId, currentClassName, currentCount, page);
        }
    }

    function filterStudents() {
        const q = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('#studentListBody tbody tr').forEach(row => {
            const text = row.textContent.toLowerCase();
            row.style.display = text.includes(q) ? '' : 'none';
        });
    }
</script>
}
