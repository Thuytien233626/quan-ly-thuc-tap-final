@using DNC.InternshipSystem.Core.Entities
@model Registration
@{
    Layout = "~/Areas/Lecturer/Views/Shared/_LayoutLecturer.cshtml";
    ViewData["Title"] = "Chi tiết sinh viên";
    
    var student = Model.Student;
    var grade = ViewBag.Grade as Grade;
    var logbooks = ViewBag.Logbooks as List<Logbook> ?? new List<Logbook>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Chi tiết sinh viên</h4>
        <p class="text-muted mb-0 small">Xem thông tin thực tập đầy đủ của sinh viên.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Trở về
    </a>
</div>

<div class="row g-4">
    <!-- Student Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body text-center p-4">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto d-flex align-items-center justify-content-center mb-3 border border-3 border-primary border-opacity-25" 
                     style="width: 80px; height: 80px;">
                    <i class="fa fa-user-graduate fa-2x"></i>
                </div>
                <h5 class="fw-bold mb-1">@(student?.User?.FullName ?? "N/A")</h5>
                <p class="text-muted mb-2">@(student?.StudentCode ?? "N/A")</p>
                
                <div class="d-flex justify-content-center gap-2 mb-3">
                    <span class="badge bg-light text-dark border px-3 py-2">
                        <i class="fa fa-door-open me-1"></i> @(student?.Class?.Name ?? "N/A")
                    </span>
                    @{
                        string statusText = Model.Status switch {
                            0 => "Chờ duyệt",
                            1 => "Đang thực tập",
                            2 => "Từ chối",
                            3 => "Hoàn thành",
                            _ => "Không rõ"
                        };
                        string statusClass = Model.Status switch {
                            0 => "warning",
                            1 => "success",
                            2 => "danger",
                            3 => "info",
                            _ => "secondary"
                        };
                    }
                    <span class="badge bg-@statusClass bg-opacity-10 text-@statusClass border border-@statusClass border-opacity-25 px-3 py-2">
                        @statusText
                    </span>
                </div>
            </div>
        </div>

        <!-- Diem tong hop -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="fa fa-chart-bar text-primary me-2"></i>Bảng điểm</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-muted">Điểm doanh nghiệp</span>
                        <span class="fw-bold">@(Model.CompanyScore?.ToString("F1") ?? "--")</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-info" style="width: @((Model.CompanyScore ?? 0) * 10)%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="small text-muted">Điểm GVHD</span>
                        <span class="fw-bold text-primary">@(grade?.InstructorScore?.ToString("F1") ?? "--")</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: @((grade?.InstructorScore ?? 0) * 10)%"></div>
                    </div>
                </div>
                <
                <hr>
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">Tổng kết</span>
                    <span class="fw-bold text-success fs-5">@(Model.FinalScore?.ToString("F1") ?? "--")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Thong tin chi tiet -->
    <div class="col-lg-8">
        <!-- Thong tin thuc tap -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0"><i class="fa fa-briefcase text-success me-2"></i>Thông tin thực tập</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Doanh nghiệp</label>
                        <div class="form-control bg-light border-0">
                            <i class="fa fa-building text-muted me-2"></i> @(Model.Company?.Name ?? Model.ExternalCompanyName ?? "N/A")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Vị trí</label>
                        <div class="form-control bg-light border-0">
                            <i class="fa fa-user-tie text-muted me-2"></i> @(Model.Position ?? "N/A")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Đợt thực tập</label>
                        <div class="form-control bg-light border-0">
                            <i class="fa fa-calendar text-muted me-2"></i> @(Model.Term?.TermName ?? "N/A")
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Ngày đăng ký</label>
                        <div class="form-control bg-light border-0">
                            <i class="fa fa-clock text-muted me-2"></i> @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Logbook Summary -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0"><i class="fa fa-book-open text-warning me-2"></i>Nhật ký thực tập (@logbooks.Count tuần)</h6>
                <a asp-controller="LogbookReview" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                    <i class="fa fa-eye me-1"></i> Xem & Duyệt
                </a>
            </div>
            <div class="card-body p-0">
                @if (logbooks.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Tuần</th>
                                    <th>Thời gian</th>
                                    <th>Tóm tắt</th>
                                    <th class="text-center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in logbooks)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge bg-primary rounded-pill">Tuần @log.WeekNumber</span>
                                        </td>
                                        <td>
                                            <small class="text-muted">
                                                @log.StartDate.ToString("dd/MM") - @log.EndDate.ToString("dd/MM/yyyy")
                                            </small>
                                        </td>
                                        <td>
                                            <span class="text-truncate d-inline-block" style="max-width: 250px;">
                                                @(log.Content.Length > 60 ? log.Content.Substring(0, 60) + "..." : log.Content)
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(log.LecturerComment))
                                            {
                                                <span class="badge bg-success-subtle text-success"><i class="fa fa-check me-1"></i>Đã duyệt</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning"><i class="fa fa-clock me-1"></i>Chờ duyệt</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fa fa-book fa-2x mb-2 opacity-25"></i>
                        <p class="mb-0 small">Sinh viên chưa nộp nhật ký nào.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="d-flex gap-2 mt-4">
            <a asp-controller="LogbookReview" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fa fa-book-reader me-1"></i> Duyệt nhật ký
            </a>
            <a asp-controller="Grading" asp-action="Grade" asp-route-id="@Model.Id" class="btn btn-outline-success">
                <i class="fa fa-pen me-1"></i> Chấm điểm
            </a>
        </div>
    </div>
</div>
