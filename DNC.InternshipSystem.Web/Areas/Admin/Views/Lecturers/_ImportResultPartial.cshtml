@model IEnumerable<DNC.InternshipSystem.Web.Areas.Admin.Controllers.LecturerImportResult>

<div class="mb-3">
    <div class="d-flex justify-content-between">
        <span class="badge bg-success fs-6"><i class="fa fa-check me-1"></i>@ViewBag.Success Thành công</span>
        <span class="badge bg-warning text-dark fs-6"><i class="fa fa-forward me-1"></i>@ViewBag.Skip Bỏ qua</span>
        <span class="badge bg-danger fs-6"><i class="fa fa-times me-1"></i>@ViewBag.Error Lỗi</span>
    </div>
</div>

<table class="table table-sm table-bordered mb-0">
    <thead class="table-light">
        <tr>
            <th>Mã GV</th>
            <th>Họ tên</th>
            <th>Kết quả</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var rowClass = item.Status == "Thành công" ? "table-success" : (item.Status == "Bỏ qua" ? "table-warning" : "table-danger");
            <tr class="@rowClass">
                <td><code>@item.Code</code></td>
                <td>@item.Name</td>
                <td>
                    @if (item.Status == "Thành công")
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                    else if (item.Status == "Bỏ qua")
                    {
                        <span class="badge bg-warning text-dark">@item.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@item.Status</span>
                    }
                </td>
                <td class="small">@item.Message</td>
            </tr>
        }
    </tbody>
</table>
