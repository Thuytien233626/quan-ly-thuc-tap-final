@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Cài đặt hệ thống";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 p-4">
        <h5 class="fw-bold mb-0"><i class="fas fa-cogs text-primary me-2"></i> Cấu hình hệ thống</h5>
    </div>
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-3 border rounded-3 bg-light">
                    <h6 class="fw-bold mb-3">Thông tin chung</h6>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Tên đơn vị</label>
                        <input type="text" class="form-control" value="Khoa Công nghệ Thông tin - DNC" disabled>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
               <div class="p-3 border rounded-3 bg-light">
                    <h6 class="fw-bold mb-3">Thông báo hệ thống</h6>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" checked disabled>
                        <label class="form-check-label">Gửi email khi có đăng ký mới</label>
                    </div>
               </div>
            </div>
        </div>
        <div class="text-center mt-5 py-5 opacity-50">
            <i class="fas fa-tools fa-3x mb-3 text-muted"></i>
            <p>Tính năng đang được hoàn thiện...</p>
        </div>
    </div>
</div>
