@{
    ViewData["Title"] = "Thêm chuyên ngành";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var batch = ViewBag.Batch as DNC.InternshipSystem.Core.Entities.StudentBatch;
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Thêm chuyên ngành mới</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Admin/AdminHome">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sinh viên</a></li>
            <li class="breadcrumb-item active">Thêm chuyên ngành</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-graduation-cap me-2 text-success"></i>Thêm chuyên ngành</h6>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
                    </div>
                }

                <!-- Thong tin boi canh -->
                <div class="alert alert-success mb-4">
                    <i class="fa fa-info-circle me-2"></i>
                    <strong>Khóa:</strong> @batch?.BatchCode (@batch?.EnrollmentYear - @batch?.GraduationYear)
                </div>

                <form asp-action="CreateMajor" method="post">
                    <input type="hidden" name="batchId" value="@ViewBag.BatchId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã chuyên ngành <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control" 
                               placeholder="VD: CNPM, CNTT, KHMT" required
                               maxlength="10" style="text-transform: uppercase;" />
                        <small class="text-muted">Viết tắt ngắn gọn, viết hoa</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Tên chuyên ngành <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" 
                               placeholder="VD: Công nghệ Phần mềm" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fa fa-plus me-1"></i> Tạo chuyên ngành
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa fa-list me-2 text-primary"></i>Các chuyên ngành phổ biến</h6>
                <table class="table table-sm table-bordered mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Mã</th>
                            <th>Tên chuyên ngành</th>
                            <th>Mã lớp</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td><code>KTPM</code></td><td>Kỹ thuật Phần mềm</td><td>DH23KPM01</td></tr>
                        <tr><td><code>CNTT</code></td><td>Công nghệ Thông tin</td><td>DH23TIN03</td></tr>
                        <tr><td><code>KHMT</code></td><td>Khoa học Máy tính</td><td>DH23KMT01</td></tr>
                        <tr><td><code>HTTT</code></td><td>Hệ thống Thông tin</td><td>DH23HTT01</td></tr>
                        <tr><td><code>MMT</code></td><td>Mạng Máy tính</td><td>DH23MMT01</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
