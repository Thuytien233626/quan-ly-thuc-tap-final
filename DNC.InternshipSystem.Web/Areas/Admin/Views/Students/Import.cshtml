@{
    ViewData["Title"] = "Import Sinh viên";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Import Sinh viên từ Excel</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Admin/AdminHome">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sinh viên</a></li>
            <li class="breadcrumb-item active">Import</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-file-excel me-2 text-success"></i>Upload file Excel</h6>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
                    </div>
                }

                <form asp-action="Import" method="post" enctype="multipart/form-data">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Chọn file Excel <span class="text-danger">*</span></label>
                        <input type="file" name="excelFile" class="form-control" accept=".xlsx,.xls" required />
                        <small class="text-muted">Chấp nhận file .xlsx hoặc .xls</small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="fa fa-upload me-1"></i> Import
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa fa-info-circle me-2 text-primary"></i>Hướng dẫn</h6>
                
                <p class="mb-3">File Excel cần có các cột theo thứ tự:</p>
                
                <table class="table table-sm table-bordered mb-3">
                    <thead class="table-primary">
                        <tr>
                            <th>Cột</th>
                            <th>Tên cột</th>
                            <th>Ví dụ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>A</td><td>STT</td><td>1</td></tr>
                        <tr><td>B</td><td>Mã sinh viên</td><td>233760</td></tr>
                        <tr><td>C</td><td>Họ đệm</td><td>Trần Bôi</td></tr>
                        <tr><td>D</td><td>Tên</td><td>Anh</td></tr>
                        <tr><td>E</td><td>Giới tính</td><td>Nữ / Nam</td></tr>
                        <tr><td>F</td><td>Ngày sinh</td><td>19/02/2005</td></tr>
                        <tr><td>G</td><td>Lớp học</td><td>DH23TIN03</td></tr>
                    </tbody>
                </table>

                <div class="alert alert-info mb-0">
                    <i class="fa fa-key me-2"></i>
                    <strong>Tài khoản SV sẽ được tạo tự động:</strong><br>
                    • Username: MSSV (233760)<br>
                    • Email: MSSV@student.dnc.edu.vn<br>
                    • Password: MSSV
                </div>

                <div class="mt-3">
                    <a asp-action="DownloadTemplate" class="btn btn-outline-success btn-sm">
                        <i class="fa fa-download me-1"></i> Tải file mẫu
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
