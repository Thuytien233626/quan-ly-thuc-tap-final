@{
    ViewData["Title"] = "Thêm lớp mới";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var major = ViewBag.Major as DNC.InternshipSystem.Core.Entities.Major;
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Thêm lớp mới</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Admin/AdminHome">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sinh viên</a></li>
            <li class="breadcrumb-item active">Thêm lớp</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-plus-circle me-2 text-primary"></i>Thêm lớp cho chuyên ngành</h6>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
                    </div>
                }

                <!-- Thong tin boi canh -->
                <div class="alert alert-info mb-4">
                    <i class="fa fa-info-circle me-2"></i>
                    <strong>Khóa:</strong> @major?.Batch?.BatchCode (@major?.Batch?.EnrollmentYear - @major?.Batch?.GraduationYear)<br>
                    <strong>Chuyên ngành:</strong> @major?.Name (@major?.Code)
                </div>

                <form asp-action="CreateClass" method="post">
                    <input type="hidden" name="majorId" value="@ViewBag.MajorId" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã lớp <span class="text-danger">*</span></label>
                        <input type="text" name="classId" class="form-control" 
                               placeholder="VD: DH23CNTT01" required
                               pattern="[A-Z0-9]+" title="Chỉ nhập chữ in hoa và số" />
                        <small class="text-muted">Mã lớp phải duy nhất, viết hoa không dấu</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Tên lớp</label>
                        <input type="text" name="className" class="form-control" 
                               placeholder="VD: Công nghệ Thông tin 01 - K11" />
                        <small class="text-muted">Để trống sẽ dùng mã lớp làm tên</small>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-plus me-1"></i> Tạo lớp
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="fa fa-lightbulb me-2 text-warning"></i>Gợi ý đặt tên</h6>
                <p class="mb-2">Quy tắc đặt mã lớp:</p>
                <ul class="mb-0">
                    <li><strong>DH</strong> + <strong>Năm nhập học</strong> + <strong>Mã CN</strong> + <strong>STT</strong></li>
                    <li>VD: <code>DH23TIN03</code> = ĐH 2023, CNTT, lớp 03</li>
                    <li>VD: <code>DH23KPM01</code> = ĐH 2023, KTPM, lớp 01</li>
                </ul>
                <hr>
                <p class="mb-2">Các lớp đang có trong chuyên ngành này:</p>
                @if (major?.Classes?.Any() == true)
                {
                    <ul class="mb-0">
                        @foreach (var c in major.Classes)
                        {
                            <li><code>@c.Id</code></li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0"><em>Chưa có lớp nào</em></p>
                }
            </div>
        </div>
    </div>
</div>
