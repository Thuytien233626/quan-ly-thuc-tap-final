@model DNC.InternshipSystem.Web.Areas.Admin.Models.ImportPreviewViewModel

<input type="hidden" id="tempFilePath" value="@Model.TempFilePath" />

<!-- Thong tin file -->
<div class="card border-0 mb-3">
    <div class="card-body">
        <div class="row g-3">
            <!-- Cac cot da nhan dien -->
            <div class="col-md-6">
                <h6 class="fw-bold mb-2"><i class="fa fa-columns me-2 text-primary"></i>Nhận diện cột</h6>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="d-flex align-items-center p-2 rounded @(Model.HasMSSV ? "bg-success-subtle" : "bg-danger-subtle")">
                            <i class="fa @(Model.HasMSSV ? "fa-check-circle text-success" : "fa-times-circle text-danger") me-2"></i>
                            <span class="small">Mã SV <span class="text-danger">*</span></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center p-2 rounded @(Model.HasHoDem ? "bg-success-subtle" : "bg-danger-subtle")">
                            <i class="fa @(Model.HasHoDem ? "fa-check-circle text-success" : "fa-times-circle text-danger") me-2"></i>
                            <span class="small">Họ đệm <span class="text-danger">*</span></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center p-2 rounded @(Model.HasTen ? "bg-success-subtle" : "bg-danger-subtle")">
                            <i class="fa @(Model.HasTen ? "fa-check-circle text-success" : "fa-times-circle text-danger") me-2"></i>
                            <span class="small">Tên <span class="text-danger">*</span></span>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center p-2 rounded @(Model.HasLopHoc ? "bg-success-subtle" : "bg-secondary-subtle")">
                            <i class="fa @(Model.HasLopHoc ? "fa-check-circle text-success" : "fa-minus-circle text-secondary") me-2"></i>
                            <span class="small">Lớp</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Thong ke -->
            <div class="col-md-6">
                <h6 class="fw-bold mb-2"><i class="fa fa-chart-bar me-2 text-info"></i>Thống kê</h6>
                <div class="row g-2 text-center">
                    <div class="col-4">
                        <div class="p-2 rounded bg-primary-subtle">
                            <div class="fs-5 fw-bold text-primary">@Model.ValidRows</div>
                            <small class="text-muted">Hợp lệ</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded bg-warning-subtle">
                            <div class="fs-5 fw-bold text-warning">@Model.ExistingStudents</div>
                            <small class="text-muted">Đã tồn tại</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 rounded bg-success-subtle">
                            <div class="fs-5 fw-bold text-success">@(Model.ValidRows - Model.ExistingStudents)</div>
                            <small class="text-muted">Sẽ thêm</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.AllRequiredColumnsFound)
{
    <div class="alert alert-danger mb-0">
        <i class="fa fa-exclamation-triangle me-2"></i>
        <strong>Không thể import!</strong> File Excel thiếu các cột bắt buộc.
    </div>
}
else if (Model.Students.Any())
{
    <div class="table-responsive" style="max-height: 250px;">
        <table class="table table-sm table-hover table-striped mb-0">
            <thead class="table-light sticky-top">
                <tr>
                    <th>MSSV</th>
                    <th>Họ tên</th>
                    @if (Model.HasLopHoc) { <th>Lớp</th> }
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Students.Take(50))
                {
                    <tr class="@(s.AlreadyExists ? "table-warning" : "")">
                        <td><code class="small">@s.StudentCode</code></td>
                        <td class="small">@s.FullName</td>
                        @if (Model.HasLopHoc)
                        {
                            <td>
                                @if (!string.IsNullOrEmpty(s.ClassCode))
                                {
                                    <span class="badge @(s.ClassExists ? "bg-success" : "bg-danger")">@s.ClassCode</span>
                                }
                            </td>
                        }
                        <td>
                            @if (s.AlreadyExists)
                            {
                                <span class="badge bg-warning text-dark">Bỏ qua</span>
                            }
                            else
                            {
                                <span class="badge bg-success">OK</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Students.Count > 50)
    {
        <div class="text-muted small text-center mt-2">
            <i class="fa fa-info-circle me-1"></i>Hiển thị 50/@Model.Students.Count sinh viên đầu tiên
        </div>
    }
}
else
{
    <div class="alert alert-warning mb-0">
        <i class="fa fa-exclamation-triangle me-2"></i>
        Không tìm thấy sinh viên hợp lệ trong file!
    </div>
}
