@model DNC.InternshipSystem.Core.Entities.Class
@{
    ViewData["Title"] = "Sửa lớp";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Sửa thông tin lớp</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Admin/AdminHome">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sinh viên</a></li>
            <li class="breadcrumb-item active">Sửa lớp</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-edit me-2 text-warning"></i>Sửa lớp @Model.Id</h6>
            </div>
            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-circle me-2"></i>@TempData["Error"]
                    </div>
                }

                <!-- Thong tin boi canh -->
                <div class="alert alert-info mb-4">
                    <i class="fa fa-info-circle me-2"></i>
                    <strong>Khóa:</strong> @Model.Major?.Batch?.BatchCode (@Model.Major?.Batch?.EnrollmentYear - @Model.Major?.Batch?.GraduationYear)<br>
                    <strong>Chuyên ngành:</strong> @Model.Major?.Name (@Model.Major?.Code)<br>
                    <strong>Mã lớp:</strong> <code>@Model.Id</code> (không thể thay đổi)
                </div>

                <form asp-action="EditClass" method="post">
                    <input type="hidden" name="classId" value="@Model.Id" />
                    
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Tên lớp <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" 
                               value="@Model.Name" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fa fa-save me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
