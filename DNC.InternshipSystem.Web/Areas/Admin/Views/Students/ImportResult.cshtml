@model IEnumerable<DNC.InternshipSystem.Web.Areas.Admin.Controllers.ImportResult>
@{
    ViewData["Title"] = "Kết quả Import";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Kết quả Import Sinh viên</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Admin/AdminHome">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Sinh viên</a></li>
            <li class="breadcrumb-item active">Kết quả</li>
        </ol>
    </nav>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa fa-check-circle me-2"></i>@TempData["Success"]
    </div>
}

<!-- Cac the tong hop -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body text-center">
                <h3 class="fw-bold mb-0">@Model.Count(r => r.Status == "Thành công")</h3>
                <small>Thành công</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-warning">
            <div class="card-body text-center">
                <h3 class="fw-bold mb-0">@Model.Count(r => r.Status == "Bỏ qua")</h3>
                <small>Bỏ qua</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-danger text-white">
            <div class="card-body text-center">
                <h3 class="fw-bold mb-0">@Model.Count(r => r.Status == "Lỗi")</h3>
                <small>Lỗi</small>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between">
        <h6 class="mb-0 fw-bold"><i class="fa fa-list me-2 text-primary"></i>Chi tiết từng dòng</h6>
        <a asp-action="Index" class="btn btn-sm btn-primary">
            <i class="fa fa-users me-1"></i> Xem danh sách SV
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Dòng</th>
                        <th>MSSV</th>
                        <th>Họ tên</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var rowClass = item.Status switch
                        {
                            "Thành công" => "table-success",
                            "Bỏ qua" => "table-warning",
                            "Lỗi" => "table-danger",
                            _ => ""
                        };
                        <tr class="@rowClass">
                            <td>@item.RowNumber</td>
                            <td><span class="badge bg-primary">@item.StudentCode</span></td>
                            <td>@item.FullName</td>
                            <td>
                                @if (item.Status == "Thành công")
                                {
                                    <span class="badge bg-success">@item.Status</span>
                                }
                                else if (item.Status == "Bỏ qua")
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@item.Status</span>
                                }
                            </td>
                            <td><small>@item.Message</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Import" class="btn btn-outline-primary">
        <i class="fa fa-upload me-1"></i> Import thêm
    </a>
</div>
