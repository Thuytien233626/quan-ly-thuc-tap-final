<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin DNC IMS</title>
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/favicon.png">

    <!-- Google Fonts: Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    
    <!-- CSS Admin tuy chinh -->
    <link rel="stylesheet" href="~/css/admin-custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/notification-bell.css" asp-append-version="true" />
</head>

<body>

    <!-- Thanh dieu huong ben (Sidebar) -->
    <nav class="sidebar">
        <a asp-area="Admin" asp-controller="AdminHome" asp-action="Index" class="sidebar-brand">
            <img src="~/logo.png" alt="DNC Logo"> 
        </a>

        @{
            string currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        }

        <div class="sidebar-menu">
            <ul class="nav flex-column">
                <!-- TONG QUAN -->
                <div class="menu-group-header">Tổng quan</div>
                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "AdminHome" ? "active" : "")" 
                       asp-area="Admin" asp-controller="AdminHome" asp-action="Index">
                        <i class="fa fa-tachometer-alt"></i> <span>Dashboard</span>
                    </a>
                </li>

                <!-- QUAN LY DAO TAO -->
                <div class="menu-group-header">Quản lý đào tạo</div>
                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "InternshipTerms" ? "active" : "")" 
                       asp-area="Admin" asp-controller="InternshipTerms" asp-action="Index">
                        <i class="fa fa-calendar-alt"></i> <span>Đợt thực tập</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "StudentBatches" ? "active" : "")" 
                       asp-area="Admin" asp-controller="StudentBatches" asp-action="Index">
                        <i class="fa fa-graduation-cap"></i> <span>Khóa học - Lớp</span>
                    </a>
                </li>

                <!-- QUAN LY NHAN SU -->
                <div class="menu-group-header">Quản lý nhân sự</div>
                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "Students" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Students" asp-action="Index">
                        <i class="fa fa-user-graduate"></i> <span>Sinh viên</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "Lecturers" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Lecturers" asp-action="Index">
                        <i class="fa fa-chalkboard-teacher"></i> <span>Giảng viên</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "Companies" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Companies" asp-action="Index">
                        <i class="fa fa-building"></i> <span>Doanh nghiệp</span>
                    </a>
                </li>

                <!-- THUC TAP & PHAN CONG -->
                <div class="menu-group-header">Thực tập & Phân công</div>
                
                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "Registrations" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Registrations" asp-action="Index">
                        <i class="fa fa-file-alt"></i> <span>Đơn đăng ký</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "Allocation" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Allocation" asp-action="Index">
                        <i class="fa fa-user-tie"></i> <span>Phân công GV</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "Grading" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Grading" asp-action="Index">
                        <i class="fa fa-award"></i> <span>Chấm điểm</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "Settings" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Settings" asp-action="Index">
                        <i class="fa fa-cogs"></i> <span>Cài đặt hệ thống</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(currentCtrl == "Information" ? "active" : "")" 
                       asp-area="Admin" asp-controller="Information" asp-action="Index">
                        <i class="fa fa-info-circle"></i> <span>Thông tin</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-footer">
            <div class="user-mini-profile mb-3 px-2 d-flex align-items-center gap-2">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center border border-primary border-opacity-25" style="width: 32px; height: 32px; font-size: 0.8rem;">
                    <i class="fa fa-user-shield"></i>
                </div>
                <div class="overflow-hidden">
                    <div class="fw-bold small text-truncate">Administrator</div>
                    <div class="text-muted" style="font-size: 0.7rem;">Quản trị viên</div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3 px-2">
                <span class="small fw-bold text-muted">Giao diện tối</span>
                <div class="form-check form-switch m-0">
                    <input class="form-check-input" type="checkbox" id="darkModeToggle" style="cursor: pointer;">
                </div>
            </div>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                <button type="button" onclick="confirmLogout()" class="btn-logout border-0 shadow-sm w-100">
                    <i class="fa fa-sign-out-alt"></i> <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </nav>

    <!-- Noi dung chinh -->
    <div class="main-content">
        <!-- Thanh tieu de tren (Top Bar) -->
        <header class="top-bar">
            <!-- Vi tri cho Breadcrumb hoac Tieu de -->
            <div class="d-flex align-items-center">
                 <button class="btn btn-light d-md-none me-3" id="sidebarToggle">
                    <i class="fa fa-bars"></i>
                 </button>
                 <h5 class="m-0 fw-bold text-secondary">@ViewData["Title"]</h5>
            </div>
            
            <!-- Thong tin nguoi dung -->
            <div class="d-flex align-items-center gap-3">
                <!-- Chuyen doi giao dien (Mobile) -->
                <button class="btn btn-link text-secondary d-md-none" onclick="document.getElementById('darkModeToggle').click()">
                    <i class="fa fa-moon"></i>
                </button>

                <!-- Thong bao -->
                <div class="dropdown">
                    <button class="btn btn-link text-secondary position-relative p-0" type="button"
                            id="notifBell" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="fa fa-bell fs-5"></i>
                        <span id="notifBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none"
                              style="font-size: 0.6rem;">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notif-dropdown p-0">
                        <div class="notif-header d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0 small"><i class="fa fa-bell text-primary me-1"></i> Thông báo</h6>
                            <div class="d-flex gap-2">
                                <button class="btn btn-link btn-sm text-primary p-0 small" id="notifReadAll" title="Đọc tất cả" style="font-size:0.72rem;">Đọc tất cả</button>
                                <button class="btn btn-link btn-sm text-danger p-0 small" id="notifClearAll" title="Xóa tất cả" style="font-size:0.72rem;">Xóa tất cả</button>
                            </div>
                        </div>
                        <div class="notif-body" id="notifList"></div>
                        <div class="notif-empty" id="notifEmpty">
                            <i class="fa fa-bell-slash d-block"></i>
                            <small class="text-muted">Không có thông báo</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center user-profile-dropdown pointer" data-bs-toggle="dropdown">
                    <div class="text-end me-3 d-none d-md-block">
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Xin chào,</small>
                        <span class="fw-bold text-dark user-name">Administrator</span>
                    </div>
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center text-primary border shadow-sm profile-img-box" 
                         style="width: 40px; height: 40px;">
                        <i class="fa fa-user"></i>
                    </div>
                </div>
            </div>
        </header>

        <!-- Phan noi dung -->
        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>

    <!-- Cac tap tin Script -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/notification-bell.js" asp-append-version="true"></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        function confirmLogout() {
            Swal.fire({
                title: 'Đăng xuất?',
                text: "Bạn có chắc chắn muốn thoát phiên làm việc?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Đăng xuất',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('logoutForm').submit();
                }
            })
        }

        // Logic giao dien toi (Dark Mode)
        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.getElementById("darkModeToggle");
            const body = document.body;

            // Tai trang thai da luu
            if (localStorage.getItem("darkMode") === "enabled") {
                body.classList.add("dark-mode");
                toggle.checked = true;
            }

            // Lang nghe su kien thay doi
            toggle.addEventListener("change", function () {
                if (this.checked) {
                    body.classList.add("dark-mode");
                    localStorage.setItem("darkMode", "enabled");
                } else {
                    body.classList.remove("dark-mode");
                    localStorage.setItem("darkMode", "disabled");
                }
            });
        });

        // Sua loi Sidebar tren mobile
        $('#sidebarToggle').click(function() {
            $('.sidebar').toggleClass('show-sidebar');
        });

        // Notification bell
        initNotificationBell('/Admin/Notification/GetNotifications');
    </script>
    
    @await Html.PartialAsync("~/Views/Shared/_ToastMessages.cshtml")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>