@model DNC.InternshipSystem.Core.Entities.InternshipTerm
@{
    ViewData["Title"] = "Sửa Đợt thực tập";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="mb-4">
    <h4 class="fw-bold mb-1">Sửa Đợt thực tập</h4>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Admin/AdminHome">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Đợt thực tập</a></li>
            <li class="breadcrumb-item active">Sửa</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-edit me-2 text-primary"></i>Chỉnh sửa: @Model.TermName</h6>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="TermName" class="form-label fw-semibold">Tên đợt <span class="text-danger">*</span></label>
                        <input asp-for="TermName" class="form-control" />
                        <span asp-validation-for="TermName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="BatchId" class="form-label fw-semibold">Khóa học <span class="text-danger">*</span></label>
                            <select asp-for="BatchId" class="form-select" asp-items="ViewBag.Batches"></select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="AcademicYear" class="form-label fw-semibold">Năm học <span class="text-danger">*</span></label>
                            <select asp-for="AcademicYear" class="form-select" asp-items="ViewBag.AcademicYears"></select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Semester" class="form-label fw-semibold">Học kỳ</label>
                            <select asp-for="Semester" class="form-select" asp-items="ViewBag.Semesters"></select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DurationInWeeks" class="form-label fw-semibold">Thời lượng</label>
                            <select asp-for="DurationInWeeks" class="form-select" asp-items="ViewBag.Durations"></select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Trạng thái</label>
                            <select asp-for="Status" class="form-select" asp-items="ViewBag.Statuses"></select>
                        </div>
                    </div>

                    <hr class="my-4">
                    <h6 class="fw-bold mb-3"><i class="fa fa-clock me-2 text-secondary"></i>Mốc thời gian</h6>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RegistrationStart" class="form-label fw-semibold">Mở đăng ký</label>
                            <input asp-for="RegistrationStart" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="RegistrationEnd" class="form-label fw-semibold">Hạn đăng ký</label>
                            <input asp-for="RegistrationEnd" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="InternshipStart" class="form-label fw-semibold">Bắt đầu thực tập</label>
                            <input asp-for="InternshipStart" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ReportDeadline" class="form-label fw-semibold">Hạn nộp báo cáo</label>
                            <input asp-for="ReportDeadline" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">Đang hoạt động</label>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
