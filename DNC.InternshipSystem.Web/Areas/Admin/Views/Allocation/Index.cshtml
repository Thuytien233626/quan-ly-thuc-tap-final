@using DNC.InternshipSystem.Core.Entities
@model List<Class>
@{
    ViewData["Title"] = "Phân công Giảng viên";
    var filter = ViewBag.CurrentFilter as string;
    var lecturers = ViewBag.Lecturers as List<DNC.InternshipSystem.Web.Areas.Admin.Controllers.LecturerOptionViewModel> ?? new();
    var approvedCounts = ViewBag.ApprovedCounts as Dictionary<string, int> ?? new();
    int totalClasses = ViewBag.TotalClasses ?? 0;
    int assignedClasses = ViewBag.AssignedClasses ?? 0;
    int unassignedClasses = ViewBag.UnassignedClasses ?? 0;
}

<style>
    .class-card {
        transition: all 0.2s;
        border-left: 4px solid transparent;
    }
    .class-card.assigned { border-left-color: var(--bs-success); }
    .class-card.unassigned { border-left-color: var(--bs-warning); }
    .class-card:hover { box-shadow: 0 .25rem .75rem rgba(0,0,0,.1)!important; }
    .stat-mini { min-width: 100px; }
    /* Popup chon GV */
    .lec-item { cursor: pointer; transition: all 0.15s; border: 2px solid transparent; border-radius: 8px; padding: 12px; margin-bottom: 8px; }
    .lec-item:hover { border-color: #3085d6; background: #f0f7ff; }
    .lec-item.current-lec { border-color: #28a745; background: #f0fff4; }
    .lec-item .lec-name { font-weight: 600; font-size: 0.95rem; }
    .lec-item .lec-info { font-size: 0.8rem; color: #777; }
    .lec-item .lec-load { font-size: 0.75rem; }
</style>

<!-- Tieu de -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold text-primary mb-1">
            <i class="fa fa-chalkboard-teacher me-2"></i>Phân công Giảng viên
        </h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="AdminHome" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active">Phân công</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Thong ke nhanh -->
<div class="row g-3 mb-4">
    <div class="col-auto">
        <div class="card border-0 shadow-sm stat-mini">
            <div class="card-body text-center py-3 px-4">
                <div class="fs-4 fw-bold text-primary">@totalClasses</div>
                <small class="text-muted">Tổng lớp</small>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card border-0 shadow-sm stat-mini">
            <div class="card-body text-center py-3 px-4">
                <div class="fs-4 fw-bold text-success">@assignedClasses</div>
                <small class="text-muted">Đã phân công</small>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card border-0 shadow-sm stat-mini">
            <div class="card-body text-center py-3 px-4">
                <div class="fs-4 fw-bold text-warning">@unassignedClasses</div>
                <small class="text-muted">Chưa phân công</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Ben trai: Danh sach lop -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-list me-2"></i>Danh sách lớp học
                    </h6>
                    <div class="btn-group btn-group-sm">
                        <a href="?filter=" class="btn @(string.IsNullOrEmpty(filter) ? "btn-primary" : "btn-outline-primary")">
                            Tất cả <span class="badge bg-white text-primary ms-1">@totalClasses</span>
                        </a>
                        <a href="?filter=unassigned" class="btn @(filter == "unassigned" ? "btn-warning text-white" : "btn-outline-warning")">
                            Chưa phân công <span class="badge bg-white text-warning ms-1">@unassignedClasses</span>
                        </a>
                        <a href="?filter=assigned" class="btn @(filter == "assigned" ? "btn-success" : "btn-outline-success")">
                            Đã phân công <span class="badge bg-white text-success ms-1">@assignedClasses</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="card-body p-0" style="max-height: 600px; overflow-y: auto;">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa fa-check-circle fa-3x mb-3 text-success opacity-50"></i>
                        <p>Không có lớp nào phù hợp với bộ lọc.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var cls in Model)
                        {
                            bool isAssigned = cls.LecturerId != null;
                            int studentCount = cls.Students?.Count ?? 0;
                            approvedCounts.TryGetValue(cls.Id, out int regCount);
                            string lecName = "";
                            if (isAssigned && cls.Lecturer?.User != null)
                            {
                                string rank = !string.IsNullOrEmpty(cls.Lecturer.AcademicRank)
                                    ? cls.Lecturer.AcademicRank + ". " : "";
                                lecName = rank + cls.Lecturer.User.FullName;
                            }

                            <div class="list-group-item class-card @(isAssigned ? "assigned" : "unassigned") py-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <div>
                                            <div class="fw-bold">
                                                <i class="fa fa-users text-primary me-1"></i> @cls.Name
                                            </div>
                                            <small class="text-muted">
                                                @(cls.Major?.Name ?? "N/A")
                                                @if (cls.Major?.Batch != null)
                                                {
                                                    <span>• @cls.Major.Batch.BatchCode</span>
                                                }
                                            </small>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <span class="badge bg-light text-dark border" title="Tổng sinh viên">
                                                <i class="fa fa-user-graduate me-1"></i>@studentCount SV
                                            </span>
                                            @if (regCount > 0)
                                            {
                                                <span class="badge bg-info-subtle text-info border" title="SV đã ĐK thực tập (đã duyệt)">
                                                    <i class="fa fa-file-signature me-1"></i>@regCount ĐK
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (isAssigned)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2">
                                                <i class="fa fa-chalkboard-teacher me-1"></i>@lecName
                                            </span>
                                            <button class="btn btn-sm btn-outline-danger btn-remove-assignment"
                                                    data-class-id="@cls.Id" data-class-name="@cls.Name" data-lecturer-name="@lecName"
                                                    title="Gỡ phân công">
                                                <i class="fa fa-times"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning px-3 py-2">
                                                <i class="fa fa-exclamation-triangle me-1"></i>Chưa phân công
                                            </span>
                                        }
                                        <!-- Nut mo popup chon GV -->
                                        <button class="btn btn-sm btn-primary btn-open-assign-popup"
                                                data-class-id="@cls.Id" data-class-name="@cls.Name"
                                                data-current-lecturer-id="@(cls.LecturerId?.ToString() ?? "")"
                                                title="@(isAssigned ? "Đổi GV" : "Phân công GV")">
                                            <i class="fa fa-user-edit me-1"></i>@(isAssigned ? "Đổi GV" : "Chọn GV")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Ben phai: Danh sach GV + Thong ke tai -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-chalkboard-teacher me-2"></i>Giảng viên hướng dẫn</h6>
                <small class="text-muted">Số lượng lớp đang phụ trách</small>
            </div>
            <div class="card-body p-0" style="max-height: 600px; overflow-y: auto;">
                <div class="list-group list-group-flush">
                    @foreach (var lec in lecturers)
                    {
                        <div class="list-group-item py-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">
                                        @if (!string.IsNullOrEmpty(lec.AcademicRank))
                                        {
                                            <span class="text-muted">@(lec.AcademicRank).</span>
                                        }
                                        @lec.Name
                                    </div>
                                    <small class="text-muted">@lec.Code • @lec.DepartmentName</small>
                                </div>
                                <div class="text-center">
                                    <span class="badge @(lec.ClassCount > 0 ? "bg-primary" : "bg-secondary-subtle text-secondary") rounded-pill px-3 py-2 fs-6">
                                        @lec.ClassCount
                                    </span>
                                    <div class="small text-muted">lớp</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Du lieu GV de render trong popup
    const lecturerData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lecturers.Select(l => new {
        id = l.Id,
        name = (!string.IsNullOrEmpty(l.AcademicRank) ? l.AcademicRank + ". " : "") + l.Name,
        code = l.Code,
        dept = l.DepartmentName,
        load = l.ClassCount
    })));

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    // Tao HTML danh sach GV cho popup
    function buildLecturerListHtml(currentLecId) {
        let html = '<div style="max-height:400px; overflow-y:auto; text-align:left;">';
        lecturerData.forEach(l => {
            const isCurrent = l.id === currentLecId;
            html += `
                <div class="lec-item ${isCurrent ? 'current-lec' : ''}" data-id="${l.id}" data-name="${l.name}">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="lec-name">${l.name} ${isCurrent ? '<span class="badge bg-success ms-1">Hiện tại</span>' : ''}</div>
                            <div class="lec-info">${l.code} • ${l.dept}</div>
                        </div>
                        <span class="badge ${l.load > 0 ? 'bg-primary' : 'bg-secondary'} rounded-pill lec-load">${l.load} lớp</span>
                    </div>
                </div>`;
        });
        html += '</div>';
        return html;
    }

    // Goi API phan cong
    async function assignLecturer(classId, lecturerId) {
        const fd = new FormData();
        fd.append('classId', classId);
        fd.append('lecturerId', lecturerId);
        fd.append('__RequestVerificationToken', token);
        const res = await fetch('/Admin/Allocation/AssignLecturerAjax', { method: 'POST', body: fd });
        return await res.json();
    }

    // Goi API go phan cong
    async function removeAssignment(classId) {
        const fd = new FormData();
        fd.append('classId', classId);
        fd.append('__RequestVerificationToken', token);
        const res = await fetch('/Admin/Allocation/RemoveAssignmentAjax', { method: 'POST', body: fd });
        return await res.json();
    }

    document.addEventListener('DOMContentLoaded', function () {

        // Mo popup chon GV
        document.querySelectorAll('.btn-open-assign-popup').forEach(btn => {
            btn.addEventListener('click', async function () {
                const classId = this.dataset.classId;
                const className = this.dataset.className;
                const currentLecId = this.dataset.currentLecturerId || '';

                const html = buildLecturerListHtml(currentLecId);

                const { value: selectedId } = await Swal.fire({
                    title: `<i class="fa fa-chalkboard-teacher text-primary"></i> Chọn GV cho lớp`,
                    html: `<div class="mb-3"><span class="badge bg-primary px-3 py-2 fs-6">${className}</span></div>${html}`,
                    showCancelButton: true,
                    showConfirmButton: false,
                    cancelButtonText: '<i class="fa fa-times"></i> Đóng',
                    width: 500,
                    customClass: { popup: 'text-start' },
                    didOpen: () => {
                        // Xu ly click chon GV trong popup
                        document.querySelectorAll('.swal2-popup .lec-item').forEach(item => {
                            item.addEventListener('click', function () {
                                Swal.close({ isConfirmed: true, value: this.dataset.id, dismiss: undefined });
                                // Xu ly phan cong ngay
                                handleAssign(classId, className, this.dataset.id, this.dataset.name);
                            });
                        });
                    }
                });
            });
        });

        // Xu ly phan cong thuc te
        async function handleAssign(classId, className, lecturerId, lecturerName) {
            Swal.fire({ title: 'Đang phân công...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            try {
                const data = await assignLecturer(classId, lecturerId);
                if (data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: 'Phân công thành công!',
                        html: `<b>${lecturerName}</b> → lớp <b>${className}</b>`,
                        timer: 1500,
                        showConfirmButton: false
                    });
                    location.reload();
                } else {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Lỗi hệ thống', text: 'Không thể kết nối đến server.' });
            }
        }

        // Go phan cong
        document.querySelectorAll('.btn-remove-assignment').forEach(btn => {
            btn.addEventListener('click', async function () {
                const classId = this.dataset.classId;
                const className = this.dataset.className;
                const lecturerName = this.dataset.lecturerName;

                const result = await Swal.fire({
                    title: 'Gỡ phân công?',
                    html: `Gỡ <b>${lecturerName}</b> khỏi lớp <b>${className}</b>?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    confirmButtonText: '<i class="fa fa-times"></i> Gỡ phân công',
                    cancelButtonText: 'Hủy'
                });

                if (!result.isConfirmed) return;

                Swal.fire({ title: 'Đang xử lý...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                try {
                    const data = await removeAssignment(classId);
                    if (data.success) {
                        await Swal.fire({ icon: 'success', title: 'Đã gỡ!', timer: 1200, showConfirmButton: false });
                        location.reload();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Lỗi', text: data.message });
                    }
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể kết nối.' });
                }
            });
        });
    });
</script>
}
