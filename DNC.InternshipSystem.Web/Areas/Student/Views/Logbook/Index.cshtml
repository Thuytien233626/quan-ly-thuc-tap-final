@using DNC.InternshipSystem.Core.Entities
@using DNC.InternshipSystem.Core.Enums
@{
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    ViewData["Title"] = "Nhật ký thực tập";

    bool hasRegistration = ViewBag.HasRegistration ?? false;
    bool isApproved = ViewBag.IsApproved ?? false;
    var registrationStatus = ViewBag.RegistrationStatus as RegistrationStatus?;
    var logbooks = ViewBag.Logbooks as List<Logbook> ?? new List<Logbook>();
    int totalWeeks = ViewBag.TotalWeeks ?? 0;
    int submittedWeeks = ViewBag.SubmittedWeeks ?? 0;
    int pendingWeeks = totalWeeks - submittedWeeks;
    if (pendingWeeks < 0) pendingWeeks = 0;
    var registration = ViewBag.Registration as Registration;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Nhật ký thực tập</h4>
        <p class="text-muted mb-0 small">Ghi chép công việc hàng tuần trong quá trình thực tập.</p>
    </div>
</div>

@if (!hasRegistration)
{
<div class="card border-0 shadow-sm">
<div class="card-body text-center py-5">
<i class="fa fa-file-signature fa-3x text-muted mb-3 d-block opacity-50"></i>
<h5 class="text-muted mb-2">Bạn chưa đăng ký thực tập</h5>
<p class="text-muted mb-3">Vui lòng đăng ký thực tập trước khi viết nhật ký.</p>
<a asp-area="Student" asp-controller="SRegister" asp-action="Index" class="btn btn-info text-white">
<i class="fa fa-file-signature me-1"></i> Đăng ký thực tập
</a>
</div>
</div>
}
else if (!isApproved)
{
<div class="card border-0 shadow-sm">
<div class="card-body text-center py-5">
    <i class="fa fa-clock fa-3x mb-3 d-block" style="color: #f59e0b; opacity: 0.6;"></i>
    @if (registrationStatus == RegistrationStatus.Pending)
    {
        <h5 class="text-muted mb-2">Đơn đăng ký đang chờ duyệt</h5>
        <p class="text-muted mb-0">Bạn có thể viết nhật ký sau khi đơn đăng ký được admin phê duyệt.</p>
    }
    else if (registrationStatus == RegistrationStatus.Rejected)
    {
        <h5 class="text-danger mb-2">Đơn đăng ký bị từ chối</h5>
        <p class="text-muted mb-3">Vui lòng liên hệ admin hoặc đăng ký lại.</p>
        <a asp-area="Student" asp-controller="SRegister" asp-action="Index" class="btn btn-outline-info">
            <i class="fa fa-redo me-2"></i>Đăng ký lại
        </a>
    }
    else
    {
        <h5 class="text-muted mb-2">Chưa thể viết nhật ký</h5>
        <p class="text-muted mb-0">Đơn đăng ký cần được phê duyệt trước.</p>
    }
</div>
</div>
}
else
{

<div class="row g-3 mb-4">
<div class="col-md-4">
<div class="stats-card">
<div class="d-flex justify-content-between align-items-center">
<div>
<div class="card-title-custom">Tổng số tuần</div>
<div class="card-value-custom">@totalWeeks</div>
</div>
<span class="stats-icon-box bg-info-subtle text-info">
<i class="fa fa-calendar-week"></i>
</span>
</div>
</div>
</div>

<div class="col-md-4">
<div class="stats-card">
<div class="d-flex justify-content-between align-items-center">
<div>
<div class="card-title-custom">Đã nộp</div>
<div class="card-value-custom text-success">@submittedWeeks</div>
</div>
<span class="stats-icon-box bg-success-subtle text-success">
<i class="fa fa-check-circle"></i>
</span>
</div>
</div>
</div>

<div class="col-md-4">
<div class="stats-card">
<div class="d-flex justify-content-between align-items-center">
<div>
<div class="card-title-custom">Chưa nộp</div>
<div class="card-value-custom text-danger">@pendingWeeks</div>
</div>
<span class="stats-icon-box bg-danger-subtle text-danger">
<i class="fa fa-exclamation-circle"></i>
</span>
</div>
</div>
</div>
</div>

<div class="card border-0 shadow-sm">
<div class="card-header bg-white py-3">
<h6 class="fw-bold mb-0">
<i class="fa fa-book-open text-info me-2"></i>
Danh sách nhật ký theo tuần
</h6>
</div>

<div class="card-body p-0">
<div class="table-responsive">
<table class="table table-hover align-middle mb-0">
<thead class="table-light">
<tr>
<th class="ps-4">Tuần</th>
<th>Ngày ghi</th>
<th>Nội dung công việc</th>
<th class="text-center">File đính kèm</th>
<th class="text-center">Nhận xét GV</th>
<th class="text-center">Trạng thái</th>
<th class="text-center">Thao tác</th>
</tr>
</thead>

<tbody>
@if (logbooks.Any())
{
foreach (var log in logbooks)
{
    bool canEdit = string.IsNullOrEmpty(log.LecturerComment);

<tr>
<td class="ps-4">
<span class="badge bg-info text-white">Tuần @log.WeekNumber</span>
</td>

<td>
@log.StartDate.ToString("dd/MM/yyyy") - @log.EndDate.ToString("dd/MM/yyyy")
</td>

<td class="text-truncate" style="max-width:250px;">
@log.Content
</td>

<td class="text-center">
@if (!string.IsNullOrEmpty(log.EvidenceImageUrl))
{
    <a href="@log.EvidenceImageUrl" target="_blank" class="btn btn-sm btn-outline-secondary" title="Xem file">
        <i class="fa fa-paperclip"></i>
    </a>
}
else
{
    <span class="text-muted small">—</span>
}
</td>

<td class="text-center">
@if (!string.IsNullOrEmpty(log.LecturerComment))
{
<span class="badge bg-primary-subtle text-primary">Đã nhận xét</span>
}
else
{
<span class="text-muted small">—</span>
}
</td>

<td class="text-center">
@if (log.ResubmitRequested)
{
    <span class="badge bg-warning-subtle text-warning"><i class="fa fa-undo me-1"></i>Chờ duyệt nộp lại</span>
}
else if (!string.IsNullOrEmpty(log.LecturerComment))
{
    <span class="badge bg-success-subtle text-success"><i class="fa fa-check me-1"></i>Đã duyệt</span>
}
else
{
    <span class="badge bg-success-subtle text-success">Đã nộp</span>
}
</td>

<td class="text-center">
<div class="btn-group btn-group-sm">
    <button class="btn btn-outline-info btn-view-log"
        data-week="@log.WeekNumber"
        data-start="@log.StartDate.ToString("dd/MM/yyyy")"
        data-end="@log.EndDate.ToString("dd/MM/yyyy")"
        data-content="@log.Content"
        data-comment="@(log.LecturerComment ?? "")"
        data-evidence="@(log.EvidenceImageUrl ?? "")"
        title="Xem chi tiết">
        <i class="fa fa-eye"></i>
    </button>

    @if (canEdit)
    {
    <button class="btn btn-outline-warning btn-edit-log"
        data-bs-toggle="modal"
        data-bs-target="#editLogModal"
        data-id="@log.Id"
        data-week="@log.WeekNumber"
        data-content="@log.Content"
        data-evidence="@(log.EvidenceImageUrl ?? "")"
        title="Sửa nhật ký">
        <i class="fa fa-edit"></i>
    </button>
    <button class="btn btn-outline-danger btn-delete-log"
        data-id="@log.Id"
        data-week="@log.WeekNumber"
        title="Xóa nhật ký">
        <i class="fa fa-trash"></i>
    </button>
    }
    else if (!log.ResubmitRequested)
    {
    <button class="btn btn-outline-warning btn-request-resubmit"
        data-id="@log.Id"
        data-week="@log.WeekNumber"
        title="Xin nộp lại">
        <i class="fa fa-undo"></i>
    </button>
    }
</div>
</td>
</tr>
}
}

@if (totalWeeks > 0 && registration?.Term != null)
{
var submittedWeekNumbers = logbooks.Select(l => l.WeekNumber).ToHashSet();
var internshipStart = registration.Term.InternshipStart;
var now = DateTime.Now;

for (int w = 1; w <= totalWeeks; w++)
{
if (submittedWeekNumbers.Contains(w)) continue;
var weekStart = internshipStart.AddDays((w - 1) * 7);
var weekEnd = weekStart.AddDays(6);
bool isFuture = weekStart > now;

<tr>
<td class="ps-4">
<span class="badge @(isFuture ? "bg-secondary" : "bg-warning text-dark")">Tuần @w</span>
</td>

<td>@weekStart.ToString("dd/MM/yyyy") - @weekEnd.ToString("dd/MM/yyyy")</td>

<td class="text-muted fst-italic">
@(isFuture ? "Chưa đến hạn" : "Chưa có nội dung")
</td>

<td class="text-center">—</td>
<td class="text-center">—</td>

<td class="text-center">
<span class="badge @(isFuture ? "bg-secondary-subtle text-secondary" : "bg-warning-subtle text-warning")">
@(isFuture ? "Chưa mở" : "Chờ nộp")
</span>
</td>

<td class="text-center">
@if (!isFuture)
{
<button class="btn btn-sm btn-info text-white btn-write-log"
data-bs-toggle="modal"
data-bs-target="#addLogModal"
data-week="@w"
data-start="@weekStart.ToString("yyyy-MM-dd")"
data-end="@weekEnd.ToString("yyyy-MM-dd")">
<i class="fa fa-pen"></i>
</button>
}
else
{
<span class="text-muted">—</span>
}
</td>
</tr>
}
}

</tbody>
</table>
</div>
</div>
</div>

}

<!-- Modal VIET nhat ky -->
<div class="modal fade" id="addLogModal">
<div class="modal-dialog modal-lg">
<div class="modal-content">
<form method="post" asp-area="Student" asp-controller="Logbook" asp-action="CreateLogbook" enctype="multipart/form-data">
@Html.AntiForgeryToken()

<div class="modal-header">
<h5 class="modal-title fw-bold">
<i class="fa fa-book-open text-info me-2"></i> Viết nhật ký
</h5>
<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
<div class="row g-3">
<div class="col-md-4">
<label class="form-label fw-semibold">Tuần</label>
<input name="WeekNumber" class="form-control" readonly>
</div>
<div class="col-md-4">
<label class="form-label fw-semibold">Từ ngày</label>
<input name="StartDate" type="date" class="form-control" readonly>
</div>
<div class="col-md-4">
<label class="form-label fw-semibold">Đến ngày</label>
<input name="EndDate" type="date" class="form-control" readonly>
</div>
<div class="col-12">
<label class="form-label fw-semibold">Công việc đã thực hiện <span class="text-danger">*</span></label>
<textarea name="Content" class="form-control" rows="5" required placeholder="Mô tả chi tiết công việc trong tuần..."></textarea>
</div>
<div class="col-12">
<label class="form-label fw-semibold">
<i class="fa fa-paperclip me-1"></i> File đính kèm (hình ảnh, tài liệu minh chứng)
</label>
<input name="EvidenceFile" type="file" class="form-control"
       accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xlsx">
<small class="text-muted">Chấp nhận: JPG, PNG, PDF, DOC, DOCX, XLSX (tối đa 10MB)</small>
</div>
</div>
</div>

<div class="modal-footer">
<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
<button type="submit" class="btn btn-info text-white">
<i class="fa fa-save me-1"></i> Lưu nhật ký
</button>
</div>
</form>
</div>
</div>
</div>

<!-- Modal SUA nhat ky -->
<div class="modal fade" id="editLogModal">
<div class="modal-dialog modal-lg">
<div class="modal-content">
<form method="post" asp-area="Student" asp-controller="Logbook" asp-action="UpdateLogbook" enctype="multipart/form-data">
@Html.AntiForgeryToken()
<input type="hidden" name="LogbookId" id="editLogbookId">

<div class="modal-header">
<h5 class="modal-title fw-bold">
<i class="fa fa-edit text-warning me-2"></i> Sửa nhật ký - <span id="editWeekLabel"></span>
</h5>
<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>

<div class="modal-body">
<div class="row g-3">
<div class="col-12">
<label class="form-label fw-semibold">Công việc đã thực hiện <span class="text-danger">*</span></label>
<textarea name="Content" id="editContent" class="form-control" rows="5" required></textarea>
</div>
<div class="col-12">
<label class="form-label fw-semibold">
<i class="fa fa-paperclip me-1"></i> File đính kèm mới (để trống nếu giữ file cũ)
</label>
<input name="EvidenceFile" type="file" class="form-control"
       accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.xlsx">
<div id="editCurrentFile" class="mt-1"></div>
</div>
</div>
</div>

<div class="modal-footer">
<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
<button type="submit" class="btn btn-warning">
<i class="fa fa-save me-1"></i> Cập nhật
</button>
</div>
</form>
</div>
</div>
</div>

<!-- Modal XEM logbook -->
<div class="modal fade" id="viewLogModal">
<div class="modal-dialog modal-lg">
<div class="modal-content">
<div class="modal-header">
<h5 class="modal-title fw-bold">
<i class="fa fa-eye text-info me-2"></i> Xem nhật ký
</h5>
<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
<div class="row g-3">
<div class="col-md-4">
<label class="form-label fw-semibold">Tuần</label>
<input id="viewWeek" class="form-control" readonly>
</div>
<div class="col-md-4">
<label class="form-label fw-semibold">Từ ngày</label>
<input id="viewStart" class="form-control" readonly>
</div>
<div class="col-md-4">
<label class="form-label fw-semibold">Đến ngày</label>
<input id="viewEnd" class="form-control" readonly>
</div>
<div class="col-12">
<label class="form-label fw-semibold">Nội dung</label>
<textarea id="viewContent" class="form-control" rows="5" readonly></textarea>
</div>
<div class="col-12" id="viewEvidenceSection" style="display:none;">
<label class="form-label fw-semibold">File đính kèm</label>
<div id="viewEvidence"></div>
</div>
<div class="col-12">
<label class="form-label fw-semibold">Nhận xét GV</label>
<textarea id="viewComment" class="form-control" rows="3" readonly></textarea>
</div>
</div>
</div>
</div>
</div>
</div>

<!-- Form XOA (hidden) -->
<form id="deleteLogForm" method="post" asp-area="Student" asp-controller="Logbook" asp-action="DeleteLogbook" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="LogbookId" id="deleteLogbookId">
</form>

@section Scripts{
<script>
document.addEventListener("DOMContentLoaded", function () {

    // Viet moi
    document.querySelectorAll(".btn-write-log").forEach(btn => {
        btn.addEventListener("click", function () {
            document.querySelector("[name='WeekNumber']").value = this.dataset.week;
            document.querySelector("[name='StartDate']").value = this.dataset.start;
            document.querySelector("[name='EndDate']").value = this.dataset.end;
        });
    });

    // Xem chi tiet
    document.querySelectorAll(".btn-view-log").forEach(btn => {
        btn.addEventListener("click", function () {
            document.getElementById("viewWeek").value = "Tuần " + this.dataset.week;
            document.getElementById("viewStart").value = this.dataset.start;
            document.getElementById("viewEnd").value = this.dataset.end;
            document.getElementById("viewContent").value = this.dataset.content;
            document.getElementById("viewComment").value = this.dataset.comment || "Chưa có nhận xét";

            var evidence = this.dataset.evidence;
            var evidSection = document.getElementById("viewEvidenceSection");
            var evidDiv = document.getElementById("viewEvidence");
            if (evidence) {
                evidSection.style.display = "block";
                evidDiv.innerHTML = '<a href="' + evidence + '" target="_blank" class="btn btn-sm btn-outline-info"><i class="fa fa-paperclip me-1"></i> Xem file đính kèm</a>';
            } else {
                evidSection.style.display = "none";
            }

            var modal = new bootstrap.Modal(document.getElementById("viewLogModal"));
            modal.show();
        });
    });

    // Sua nhat ky
    document.querySelectorAll(".btn-edit-log").forEach(btn => {
        btn.addEventListener("click", function () {
            document.getElementById("editLogbookId").value = this.dataset.id;
            document.getElementById("editWeekLabel").textContent = "Tuần " + this.dataset.week;
            document.getElementById("editContent").value = this.dataset.content;

            var evidence = this.dataset.evidence;
            var fileDiv = document.getElementById("editCurrentFile");
            if (evidence) {
                fileDiv.innerHTML = '<small class="text-muted">File hiện tại: </small><a href="' + evidence + '" target="_blank" class="text-info small">Xem file</a>';
            } else {
                fileDiv.innerHTML = '<small class="text-muted">Chưa có file đính kèm</small>';
            }
        });
    });

    // Xoa nhat ky
    document.querySelectorAll(".btn-delete-log").forEach(btn => {
        btn.addEventListener("click", function () {
            var logId = this.dataset.id;
            var week = this.dataset.week;
            Swal.fire({
                title: 'Xác nhận xóa?',
                html: 'Bạn có chắc muốn xóa nhật ký <strong>Tuần ' + week + '</strong>?<br><small class="text-muted">Hành động này không thể hoàn tác.</small>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa fa-trash me-1"></i> Xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById("deleteLogbookId").value = logId;
                    document.getElementById("deleteLogForm").submit();
                }
            });
        });
    });

    // Xin nop lai (AJAX)
    var csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    document.querySelectorAll(".btn-request-resubmit").forEach(btn => {
        btn.addEventListener("click", function () {
            var logId = this.dataset.id;
            var week = this.dataset.week;
            Swal.fire({
                title: 'Xin nộp lại',
                html: 'Gửi yêu cầu nộp lại nhật ký <strong>Tuần ' + week + '</strong> tới giảng viên.',
                input: 'textarea',
                inputLabel: 'Lý do xin nộp lại',
                inputPlaceholder: 'VD: Nội dung bị sai, cần bổ sung thêm...',
                showCancelButton: true,
                confirmButtonText: '<i class="fa fa-paper-plane me-1"></i> Gửi yêu cầu',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#f59e0b',
                inputValidator: (value) => {
                    if (!value) return 'Vui lòng nhập lý do.';
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch('@Url.Action("RequestResubmit", "Logbook")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': csrfToken
                        },
                        body: 'logbookId=' + logId + '&reason=' + encodeURIComponent(result.value) + '&__RequestVerificationToken=' + encodeURIComponent(csrfToken)
                    })
                    .then(r => r.json())
                    .then(res => {
                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đã gửi!',
                                text: res.message,
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    })
                    .catch(() => Swal.fire('Lỗi', 'Lỗi kết nối server', 'error'));
                }
            });
        });
    });

});
</script>
}
