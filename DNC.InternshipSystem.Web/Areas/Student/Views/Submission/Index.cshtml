@using DNC.InternshipSystem.Core.Entities

@{
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    ViewData["Title"] = "Nộp báo cáo";

    bool hasRegistration = ViewBag.HasRegistration ?? false;
    var registration = ViewBag.Registration as Registration;
    int logbookCount = ViewBag.LogbookCount ?? 0;
    int totalWeeks = ViewBag.TotalWeeks ?? 0;

    int progressPercent = totalWeeks > 0
        ? (int)Math.Round((double)logbookCount / totalWeeks * 100)
        : 0;

    var submissions = ViewBag.Submissions as List<Submission>;

    string reportDeadline = registration?.Term?.ReportDeadline
        .ToString("dd/MM/yyyy") ?? "Chưa xác định";
}

<div class="container-fluid py-4">

    <div class="row">

        <div class="col-lg-8">

            <!-- Upload report -->
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0">
                        <i class="fa fa-upload text-info me-2"></i>
                        Gửi báo cáo mới
                    </h6>
                </div>

                <div class="card-body">

                    <form asp-action="SubmitReport" method="post" enctype="multipart/form-data">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Loại báo cáo</label>

                                <select class="form-select" name="ReportType" required>

                                    <option value="">-- Chọn loại báo cáo --</option>
                                    <option>Báo cáo tuần</option>
                                    <option>Báo cáo giữa kỳ</option>
                                    <option>Báo cáo cuối kỳ</option>
                                    <option>Phiếu đánh giá DN</option>

                                </select>
                            </div>

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">Tiêu đề</label>

                                <input type="text"
                                       class="form-control"
                                       name="Title"
                                       placeholder="VD: Báo cáo tuần 4"
                                       required>

                            </div>

                            <div class="col-12">

                                <label class="form-label fw-semibold">File đính kèm</label>

                                <input type="file"
                                       class="form-control"
                                       name="File"
                                       accept=".pdf,.docx,.xlsx"
                                       required>

                            </div>

                            <div class="col-12">

                                <label class="form-label fw-semibold">Ghi chú</label>

                                <textarea class="form-control"
                                          name="Note"
                                          rows="3"
                                          placeholder="Ghi chú thêm nếu cần"></textarea>

                            </div>

                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-end gap-2">

                            <button type="reset"
                                    class="btn btn-outline-secondary">

                                <i class="fa fa-redo me-1"></i>
                                Đặt lại

                            </button>

                            <button type="submit"
                                    class="btn btn-info text-white">

                                <i class="fa fa-paper-plane me-1"></i>
                                Gửi báo cáo

                            </button>

                        </div>

                    </form>

                </div>
            </div>

            <!-- History -->
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h6 class="fw-bold mb-0">
                        <i class="fa fa-history text-secondary me-2"></i>
                        Lịch sử nộp báo cáo
                    </h6>

                </div>

                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">#</th>
                                <th>Tiêu đề</th>
                                <th>Loại</th>
                                <th>Ngày nộp</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">File</th>

                            </tr>

                        </thead>

                        <tbody>

                        @if (submissions != null && submissions.Any())
                        {
                            int i = 1;

                            foreach (var item in submissions)
                            {

                                <tr>

                                    <td class="ps-4">@i</td>

                                    <td>@item.Title</td>

                                    <td>@item.Type</td>

                                    <td>@item.SubmittedDate.ToString("dd/MM/yyyy")</td>

                                    <td class="text-center">

                                        @if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Đã duyệt
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Chờ duyệt
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <a asp-action="Download"
                                           asp-route-path="@item.FilePath"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Tải file">

                                            <i class="fa fa-download"></i>

                                        </a>

                                    </td>

                                </tr>

                                i++;
                            }
                        }
                        else
                        {

                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-4">

                                    <i class="fa fa-inbox me-1"></i>
                                    Chưa có báo cáo nào được nộp.

                                </td>

                            </tr>

                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Right info panel -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">

                    <h6 class="fw-bold mb-0">
                        <i class="fa fa-info-circle text-primary me-2"></i>
                        Thông tin báo cáo
                    </h6>

                </div>

                <div class="card-body">

                    <p class="mb-2">
                        <strong>Hạn nộp:</strong>
                        <span class="text-danger">
                            @reportDeadline
                        </span>
                    </p>

                    <p class="mb-2">
                        <strong>Số tuần đã ghi logbook:</strong>
                        @logbookCount / @totalWeeks
                    </p>

                    <div class="progress mb-3" style="height:8px">

                        <div class="progress-bar bg-success"
                             style="width:@progressPercent%">

                        </div>

                    </div>

                    <small class="text-muted">
                        Hoàn thành: @progressPercent%
                    </small>

                </div>

            </div>

        </div>

    </div>

</div>