@using DNC.InternshipSystem.Core.Entities
@using DNC.InternshipSystem.Core.Enums

@{
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    ViewData["Title"] = "Nộp báo cáo thực tập";

    bool hasRegistration = ViewBag.HasRegistration ?? false;
    bool isApproved = ViewBag.IsApproved ?? false;
    var registrationStatus = ViewBag.RegistrationStatus as RegistrationStatus?;
    var registration = ViewBag.Registration as Registration;
    int logbookCount = ViewBag.LogbookCount ?? 0;
    int totalWeeks = ViewBag.TotalWeeks ?? 0;

    int progressPercent = totalWeeks > 0
        ? (int)Math.Round((double)logbookCount / totalWeeks * 100)
        : 0;

    var submissions = ViewBag.Submissions as List<Submission> ?? new List<Submission>();
    var existingReport = submissions.FirstOrDefault(s => s.Type == "Báo cáo thực tập");
    bool hasSubmitted = existingReport != null;

    string reportDeadline = registration?.Term?.ReportDeadline
        .ToString("dd/MM/yyyy") ?? "Chưa xác định";
}

@if (!hasRegistration)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fa fa-file-signature fa-3x text-muted mb-3 d-block opacity-50"></i>
            <h5 class="text-muted mb-2">Bạn chưa đăng ký thực tập</h5>
            <p class="text-muted mb-3">Vui lòng đăng ký thực tập trước khi nộp báo cáo.</p>
            <a asp-area="Student" asp-controller="SRegister" asp-action="Index" class="btn btn-info text-white">
                <i class="fa fa-file-signature me-2"></i>Đăng ký thực tập
            </a>
        </div>
    </div>
}
else if (!isApproved)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fa fa-clock fa-3x mb-3 d-block" style="color: #f59e0b; opacity: 0.6;"></i>
            @if (registrationStatus == RegistrationStatus.Pending)
            {
                <h5 class="text-muted mb-2">Đơn đăng ký đang chờ duyệt</h5>
                <p class="text-muted mb-0">Bạn có thể nộp báo cáo sau khi đơn đăng ký được admin phê duyệt.</p>
            }
            else if (registrationStatus == RegistrationStatus.Rejected)
            {
                <h5 class="text-danger mb-2">Đơn đăng ký bị từ chối</h5>
                <p class="text-muted mb-3">Vui lòng liên hệ admin hoặc đăng ký lại.</p>
                <a asp-area="Student" asp-controller="SRegister" asp-action="Index" class="btn btn-outline-info">
                    <i class="fa fa-redo me-2"></i>Đăng ký lại
                </a>
            }
            else
            {
                <h5 class="text-muted mb-2">Chưa thể nộp báo cáo</h5>
                <p class="text-muted mb-0">Đơn đăng ký cần được phê duyệt trước.</p>
            }
        </div>
    </div>
}
else
{

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Nộp báo cáo thực tập</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Student/StudentHome">Dashboard</a></li>
                <li class="breadcrumb-item active">Nộp báo cáo</li>
            </ol>
        </nav>
    </div>
</div>



<div class="row g-4">

    <!-- Cot trai: Form nop / Trang thai -->
    <div class="col-lg-8">

        @if (hasSubmitted)
        {
            <!-- Da nop roi - Hien trang thai -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0">
                        <i class="fa fa-check-circle text-success me-2"></i>
                        Báo cáo đã nộp
                    </h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-success bg-success bg-opacity-10 border-0 mb-4">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-file-pdf fa-2x text-success me-3"></i>
                            <div class="flex-grow-1">
                                <h6 class="mb-1 fw-bold">@existingReport!.Title</h6>
                                <small class="text-muted">
                                    Nộp lúc: @existingReport.SubmittedDate.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                            <div>
                                @if (existingReport.Status == "Approved")
                                {
                                    <span class="badge bg-success fs-6">
                                        <i class="fa fa-check me-1"></i>Đã duyệt
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark fs-6">
                                        <i class="fa fa-clock me-1"></i>Chờ duyệt
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted fw-semibold mb-1">File đã nộp</label>
                            <div>
                                <a asp-action="Download" asp-route-path="@existingReport.FilePath"
                                   class="btn btn-outline-primary btn-sm" target="_blank">
                                    <i class="fa fa-download me-1"></i>Tải file báo cáo
                                </a>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(existingReport.Note))
                        {
                            <div class="col-md-6">
                                <label class="form-label small text-muted fw-semibold mb-1">Ghi chú</label>
                                <p class="mb-0">@existingReport.Note</p>
                            </div>
                        }
                    </div>

                    @if (existingReport.Status == "Pending")
                    {
                        <hr class="my-3">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-warning btn-sm" data-bs-toggle="collapse" data-bs-target="#editReportForm">
                                <i class="fa fa-edit me-1"></i>Chỉnh sửa
                            </button>
                            <form asp-action="DeleteReport" method="post" id="deleteReportForm" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@existingReport.Id" />
                                <button type="button" class="btn btn-outline-danger btn-sm" id="btnDeleteReport">
                                    <i class="fa fa-trash me-1"></i>Hủy báo cáo
                                </button>
                            </form>
                        </div>

                        <!-- Form chinh sua (an/hien) -->
                        <div class="collapse mt-3" id="editReportForm">
                            <div class="card card-body bg-light border">
                                <form asp-action="UpdateReport" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="id" value="@existingReport.Id" />
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label fw-semibold small">Tiêu đề</label>
                                            <input type="text" class="form-control form-control-sm" name="Title" value="@existingReport.Title" required>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold small">Thay file mới <span class="text-muted">(tùy chọn)</span></label>
                                            <input type="file" class="form-control form-control-sm" name="File" accept=".pdf,.docx,.xlsx">
                                            <small class="text-muted">Để trống nếu không muốn thay file</small>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label fw-semibold small">Ghi chú</label>
                                            <textarea class="form-control form-control-sm" name="Note" rows="2">@existingReport.Note</textarea>
                                        </div>
                                        <div class="col-12 text-end">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#editReportForm">Hủy</button>
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                <i class="fa fa-save me-1"></i>Lưu thay đổi
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Chua nop - Hien form -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold mb-0">
                        <i class="fa fa-upload text-info me-2"></i>
                        Nộp báo cáo thực tập
                    </h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-info bg-info bg-opacity-10 border-0 mb-4">
                        <i class="fa fa-info-circle me-2"></i>
                        <small>Nộp file báo cáo thực tập cuối kỳ (PDF, DOCX, XLSX). Tối đa 10MB. Chỉ được nộp <strong>1 lần</strong>.</small>
                    </div>

                    <form asp-action="SubmitReport" method="post" enctype="multipart/form-data">

                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    Tiêu đề báo cáo <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       class="form-control"
                                       name="Title"
                                       placeholder="VD: Báo cáo thực tập tại Công ty ABC"
                                       required>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    File báo cáo <span class="text-danger">*</span>
                                </label>
                                <input type="file"
                                       class="form-control"
                                       name="File"
                                       accept=".pdf,.docx,.xlsx"
                                       required>
                                <small class="text-muted">Chấp nhận: PDF, DOCX, XLSX (tối đa 10MB)</small>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Ghi chú</label>
                                <textarea class="form-control"
                                          name="Note"
                                          rows="3"
                                          placeholder="Ghi chú thêm nếu cần (tùy chọn)"></textarea>
                            </div>

                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-outline-secondary">
                                <i class="fa fa-redo me-1"></i>Đặt lại
                            </button>
                            <button type="submit" class="btn btn-info text-white">
                                <i class="fa fa-paper-plane me-1"></i>Gửi báo cáo
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        }

    </div>

    <!-- Cot phai: Thong tin -->
    <div class="col-lg-4">

        <!-- Card trang thai nop -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">
                    <i class="fa fa-clipboard-check text-primary me-2"></i>
                    Trạng thái nộp
                </h6>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    @if (hasSubmitted)
                    {
                        <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="fa fa-check"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-semibold text-success">Đã nộp báo cáo</p>
                            <small class="text-muted">@existingReport!.SubmittedDate.ToString("dd/MM/yyyy")</small>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                            <i class="fa fa-exclamation"></i>
                        </div>
                        <div>
                            <p class="mb-0 fw-semibold text-warning">Chưa nộp báo cáo</p>
                            <small class="text-muted">Hạn nộp: @reportDeadline</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Card thong tin dot -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">
                    <i class="fa fa-info-circle text-info me-2"></i>
                    Thông tin
                </h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small text-muted fw-semibold mb-1">Hạn nộp</label>
                    <p class="mb-0 fw-semibold text-danger">
                        <i class="fa fa-calendar-times me-1"></i>@reportDeadline
                    </p>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted fw-semibold mb-1">Nhật ký thực tập</label>
                    <p class="mb-1">@logbookCount / @totalWeeks tuần</p>
                    <div class="progress" style="height:6px">
                        <div class="progress-bar bg-success" style="width:@(progressPercent)%"></div>
                    </div>
                    <small class="text-muted">Hoàn thành: @progressPercent%</small>
                </div>

                <hr>

                <div class="small text-muted">
                    <p class="mb-1"><i class="fa fa-check-circle text-success me-1"></i> Hoàn thành nhật ký trước khi nộp</p>
                    <p class="mb-1"><i class="fa fa-file-pdf text-danger me-1"></i> File PDF, DOCX, XLSX</p>
                    <p class="mb-0"><i class="fa fa-database text-info me-1"></i> Tối đa 10MB</p>
                </div>
            </div>
        </div>

    </div>

</div>

} @* end else isApproved *@

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    // Huy bao cao
    const deleteBtn = document.getElementById('btnDeleteReport');
    if (deleteBtn) {
        deleteBtn.addEventListener('click', async function () {
            const result = await Swal.fire({
                title: '<i class="fa fa-exclamation-triangle text-danger me-2"></i>Hủy báo cáo?',
                html: 'Bạn có chắc chắn muốn hủy báo cáo đã nộp?<br><small class="text-muted">File báo cáo sẽ bị xóa và bạn sẽ cần nộp lại.</small>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa fa-trash me-1"></i>Hủy báo cáo',
                cancelButtonText: 'Không, giữ lại'
            });
            if (result.isConfirmed) {
                document.getElementById('deleteReportForm').submit();
            }
        });
    }
});
</script>
}