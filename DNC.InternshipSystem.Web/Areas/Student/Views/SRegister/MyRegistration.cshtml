@model DNC.InternshipSystem.Core.Entities.Registration
@using DNC.InternshipSystem.Core.Enums

<div class="container mt-4">

<h3 class="mb-4"><i class="fa fa-file-alt text-primary me-2"></i>Đơn đăng ký thực tập của tôi</h3>

@if (Model == null)
{
    <div class="alert alert-warning">
        Bạn chưa đăng ký thực tập.
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        Đăng ký ngay
</a>
}
else
{

<div class="card p-3 mb-3">
    <h5><i class="fa fa-building text-info me-2"></i>Doanh nghiệp</h5>

    @if (Model.CompanyId != null)
    {
        <p><b>Tên:</b> @Model.Company?.Name</p>
        <p><b>Tỉnh:</b> @Model.Company?.Province</p>
    }
    else
    {
        <p><b>Tên:</b> @Model.ExternalCompanyName</p>
        <p><b>Địa chỉ:</b> @Model.ExternalCompanyAddress</p>
    }

</div>


<div class="card shadow-sm p-4 mb-3">

<h5 class="mb-3"><i class="fa fa-calendar-alt text-info me-2"></i>Thông tin đợt thực tập</h5>

<div class="row mb-3">

<div class="col-md-6">
<label class="form-label">Tên đợt</label>
<input class="form-control" value="@Model.Term?.TermName" readonly />
</div>

<div class="col-md-6">
<label class="form-label">Ngày đăng ký</label>
<input class="form-control" value="@Model.CreatedDate.ToShortDateString()" readonly />
</div>

</div>

</div>


<div class="card shadow-sm p-4 mb-3">

<h5 class="mb-3"><i class="fa fa-briefcase text-info me-2"></i>Thông tin đăng ký</h5>

<div class="row mb-3">

<div class="col-md-6">
<label class="form-label">Vị trí thực tập</label>
<input class="form-control" value="@Model.Position" readonly />
</div>

<div class="col-md-6">
<label class="form-label">Trạng thái</label>

<div>

@if (Model.Status == RegistrationStatus.Pending)
{
<span class="badge bg-warning fs-6">Chờ duyệt</span>
}
else if (Model.Status == RegistrationStatus.Approved)
{
<span class="badge bg-success fs-6">Đã duyệt</span>
}
else
{
<span class="badge bg-danger fs-6">Từ chối</span>
}

</div>

</div>

</div>

</div>


<div class="text-end">

@if (Model.Status == RegistrationStatus.Pending)
{
<form asp-area="Student"
      asp-controller="SRegister"
      asp-action="UpdateRegistration"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.Id" />

   <button type="submit" class="btn btn-warning">
    <i class="fa fa-refresh"></i> Đăng ký lại
</button>

<a asp-action="Index" class="btn btn-outline-secondary">
    <i class="fa fa-arrow-left"></i> Quay lại
</a>

</form>
}


</div>

}

</div>