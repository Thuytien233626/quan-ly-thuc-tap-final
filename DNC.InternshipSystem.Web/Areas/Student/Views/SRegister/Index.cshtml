@using DNC.InternshipSystem.Core.Entities
@{
    Layout = "~/Areas/Student/Views/Shared/_LayoutStudent.cshtml";
    ViewData["Title"] = "Đăng ký thực tập";

    var companies = ViewBag.Companies as List<Company> ?? new List<Company>();
    var provinces = ViewBag.Provinces as List<string> ?? new List<string>();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    string searchVal = ViewBag.Search ?? "";
    string selectedProvince = ViewBag.SelectedProvince ?? "";

    // Mau icon cho card, xoay vong theo index
    var iconColors = new[] { "info", "primary", "success", "warning", "danger", "secondary" };
}
<div id="antiForgeryTokenContainer" style="display: none;">
    @Html.AntiForgeryToken()
</div>
<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Đăng ký thực tập</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Student/StudentHome">Dashboard</a></li>
                <li class="breadcrumb-item active">Đăng ký</li>
            </ol>
        </nav>
    </div>
    <div>
        <span class="badge bg-info bg-opacity-10 text-info px-3 py-2">
            <i class="fa fa-building me-1"></i> @totalItems doanh nghiệp
        </span>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-4" id="registerTab" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="partner-tab" data-bs-toggle="tab" data-bs-target="#partnerPane" type="button" role="tab">
            <i class="fa fa-handshake me-1"></i> Doanh nghiệp đối tác
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="external-tab" data-bs-toggle="tab" data-bs-target="#externalPane" type="button" role="tab">
            <i class="fa fa-pen-fancy me-1"></i> Tự liên hệ doanh nghiệp
        </button>
    </li>
</ul>
<a asp-area="Student"
   asp-controller="SRegister"
   asp-action="MyRegistration"
   class="btn btn-primary">
   Xem đăng ký
</a>

<div class="tab-content" id="registerTabContent">
    <!-- TAB 1: Danh sach DN doi tac -->
    <div class="tab-pane fade show active" id="partnerPane" role="tabpanel">
        <!-- Bo loc (submit ve server) -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <form method="get" asp-area="Student" asp-controller="SRegister" asp-action="Index">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Tìm kiếm</label>
                            <input type="text" class="form-control" name="search" placeholder="Tên công ty..." value="@searchVal">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small">Tỉnh / Thành phố</label>
                            <select class="form-select" name="province">
                                <option value="">Tất cả</option>
                                @foreach (var prov in provinces)
                                {
                                    <option value="@prov" selected="@(prov == selectedProvince)">@prov</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-info text-white w-100">
                                <i class="fa fa-search me-1"></i> Lọc
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(searchVal) || !string.IsNullOrEmpty(selectedProvince))
                        {
                            <div class="col-md-2">
                                <a href="/Student/SRegister" class="btn btn-outline-secondary w-100">
                                    <i class="fa fa-times me-1"></i> Bỏ lọc
                                </a>
                            </div>
                        }
                    </div>
                </form>
            </div>
        </div>

        <!-- Danh sach card DN tu DB -->
        <div class="row g-4" id="companyGrid">
            @if (companies.Any())
            {
                @for (int i = 0; i < companies.Count; i++)
                {
                    var company = companies[i];
                    var color = iconColors[i % iconColors.Length];
                    <div class="col-md-6 col-xl-4 company-card">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex align-items-start justify-content-between mb-3">
                                    <div class="rounded-3 bg-@color bg-opacity-10 text-@color d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fa fa-building fa-lg"></i>
                                    </div>
                                    <span class="badge bg-success-subtle text-success">Đối tác</span>
                                </div>
                                <h6 class="fw-bold mb-1">@company.Name</h6>
                                <p class="text-muted small mb-1">
                                    <i class="fa fa-map-marker-alt me-1"></i>@(string.IsNullOrEmpty(company.Address) ? company.Province : company.Address)
                                </p>
                                @if (!string.IsNullOrEmpty(company.Province))
                                {
                                    <p class="text-muted small mb-2">
                                        <i class="fa fa-city me-1"></i>@company.Province
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(company.PhoneNumber))
                                {
                                    <p class="text-muted small mb-2">
                                        <i class="fa fa-phone me-1"></i>@company.PhoneNumber
                                    </p>
                                }
                                <div class="d-flex gap-2 mt-auto">
                                    <button class="btn btn-sm btn-outline-info flex-fill btn-view-company"
                                            data-name="@company.Name"
                                            data-address="@company.Address"
                                            data-province="@company.Province"
                                            data-phone="@company.PhoneNumber"
                                            data-contact="@company.ContactPerson"
                                            data-email="@company.ContactEmail">
                                        <i class="fa fa-eye me-1"></i> Chi tiết
                                    </button>
                                    <button class="btn btn-sm btn-info text-white flex-fill btn-register-company"
                                            data-id="@company.Id"
                                            data-name="@company.Name">
                                        <i class="fa fa-paper-plane me-1"></i> Đăng ký
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="fa fa-inbox fa-3x text-muted mb-3 d-block"></i>
                    @if (!string.IsNullOrEmpty(searchVal) || !string.IsNullOrEmpty(selectedProvince))
                    {
                        <p class="text-muted">Không tìm thấy doanh nghiệp phù hợp với bộ lọc.</p>
                        <a href="/Student/SRegister" class="btn btn-outline-info btn-sm">
                            <i class="fa fa-redo me-1"></i> Xem tất cả
                        </a>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có doanh nghiệp đối tác nào trong hệ thống.</p>
                    }
                </div>
            }
        </div>

        <!-- PHAN TRANG -->
        @if (totalPages > 1)
        {
            <nav aria-label="Pagination" class="mt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        Trang <strong>@currentPage</strong> / @totalPages (tổng @totalItems doanh nghiệp)
                    </small>
                    <ul class="pagination pagination-sm mb-0">
                        @{
                            // Xay dung query string co san
                            string BuildUrl(int p)
                            {
                                var qs = new List<string> { $"page={p}" };
                                if (!string.IsNullOrEmpty(searchVal)) qs.Add($"search={Uri.EscapeDataString(searchVal)}");
                                if (!string.IsNullOrEmpty(selectedProvince)) qs.Add($"province={Uri.EscapeDataString(selectedProvince)}");
                                return $"/Student/SRegister?{string.Join("&", qs)}";
                            }
                        }

                        <!-- Trang truoc -->
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@BuildUrl(currentPage - 1)">
                                <i class="fa fa-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            // Hien thi cac so trang
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item"><a class="page-link" href="@BuildUrl(1)">1</a></li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            for (int p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link" href="@BuildUrl(p)">@p</a>
                                </li>
                            }

                            if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item"><a class="page-link" href="@BuildUrl(totalPages)">@totalPages</a></li>
                            }
                        }

                        <!-- Trang sau -->
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@BuildUrl(currentPage + 1)">
                                <i class="fa fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        }
    </div>

    <!-- TAB 2: Tu lien he DN -->
    <div class="tab-pane fade" id="externalPane" role="tabpanel">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                    <i class="fa fa-info-circle me-2"></i>
                   <strong> Nếu bạn đã tự liên hệ và được doanh nghiệp đồng ý cho thực tập, hãy điền thông tin vào form bên dưới để đăng ký. Trường hợp bạn chưa liên hệ được doanh nghiệp, vui lòng ưu tiên đăng ký tại các doanh nghiệp đối tác ở tab bên cạnh.</strong>
                   
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h6 class="mb-0 fw-bold"><i class="fa fa-pen-fancy text-info me-2"></i>Đăng ký doanh nghiệp tự liên hệ</h6>
                        <small class="text-muted">Điền thông tin doanh nghiệp bạn đã tự liên hệ để thực tập.</small>
                    </div>
                    <div class="card-body">
                       <form id="externalForm"
      method="post"
      asp-area="Student"
      asp-controller="SRegister"
      asp-action="SubmitExternal">

    @Html.AntiForgeryToken()

    <h6 class="fw-bold text-info mb-3 border-bottom pb-2">
        <i class="fa fa-building me-2"></i>Thông tin Doanh nghiệp
    </h6>

    <div class="row g-3 mb-4">

        <div class="col-md-8">
            <label class="form-label fw-semibold">
                Tên công ty <span class="text-danger">*</span>
            </label>
            <input name="CompanyName"
                   type="text"
                   class="form-control"
                   placeholder="VD: Công ty TNHH ABC"
                   required>
        </div>

        <div class="col-md-4">
            <label class="form-label fw-semibold">Mã số thuế</label>
            <input name="TaxCode"
                   type="text"
                   class="form-control"
                   placeholder="VD: 1801234567">
        </div>

        <div class="col-12">
            <label class="form-label fw-semibold">
                Địa chỉ <span class="text-danger">*</span>
            </label>
            <input name="Address"
                   type="text"
                   class="form-control"
                   placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố"
                   required>
        </div>

    </div>


    <h6 class="fw-bold text-info mb-3 border-bottom pb-2">
        <i class="fa fa-user me-2"></i>Người liên hệ tại Doanh nghiệp
    </h6>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Họ tên người liên hệ <span class="text-danger">*</span>
            </label>
            <input name="ContactPerson"
                   type="text"
                   class="form-control"
                   placeholder="VD: Nguyễn Văn A"
                   required>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Chức vụ</label>
            <input name="PositionTitle"
                   type="text"
                   class="form-control"
                   placeholder="VD: Trưởng phòng IT">
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">
                Số điện thoại <span class="text-danger">*</span>
            </label>
            <input name="Phone"
                   type="tel"
                   class="form-control"
                   placeholder="0901234567"
                   required>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold">Email</label>
            <input name="Email"
                   type="email"
                   class="form-control"
                   placeholder="email@company.com"
                   required>
        </div>

    </div>


    <h6 class="fw-bold text-info mb-3 border-bottom pb-2">
        <i class="fa fa-briefcase me-2"></i>Thông tin Thực tập
    </h6>

    <div class="row g-3 mb-4">

        <div class="col-md-8">
            <label class="form-label fw-semibold">
                Vị trí thực tập <span class="text-danger">*</span>
            </label>
            <input name="Position"
                   type="text"
                   class="form-control"
                   placeholder="VD: Thực tập sinh lập trình Web"
                   required>
        </div>

        <div class="col-12">
            <label class="form-label fw-semibold">Ghi chú</label>
            <textarea name="Note"
                      class="form-control"
                      rows="3"
                      placeholder="Ghi chú thêm (nếu có)..."></textarea>
        </div>

    </div>


    <hr class="my-4">

    <div class="d-flex justify-content-end gap-2">

        <button type="reset" class="btn btn-outline-secondary">
            <i class="fa fa-redo me-1"></i> Đặt lại
        </button>

        <button type="submit" class="btn btn-info text-white">
            <i class="fa fa-paper-plane me-1"></i> Gửi đơn đăng ký
        </button>

    </div>

</form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    const tokenElement = document.querySelector('#antiForgeryTokenContainer input[name="__RequestVerificationToken"]');
    const token = tokenElement ? tokenElement.value : '';

    console.log('Page loaded. Token available:', !!token);

    // ===== ĐĂNG KÝ DOANH NGHIỆP ĐỐI TÁC =====
    document.querySelectorAll('.btn-register-company').forEach(btn => {
        btn.addEventListener('click', async function (e) {
            e.preventDefault();

            const companyId = this.dataset.id;
            const companyName = this.dataset.name;
            
            console.log('Register button clicked. Company ID:', companyId, 'Name:', companyName);

            if (!companyId) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Không tìm thấy thông tin doanh nghiệp.',
                    confirmButtonColor: '#0ea5e9'
                });
                return;
            }

            const { value: position } = await Swal.fire({
                title: `<i class="fa fa-paper-plane text-info me-2"></i>Đăng ký tại`,
                html: `
                    <p class="fw-bold text-info mb-3">${companyName}</p>
                    <div class="text-start">
                        <label class="form-label fw-semibold">
                            Vị trí thực tập <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="swal-position" class="form-control"
                               placeholder="VD: Thực tập sinh lập trình" autofocus>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: '<i class="fa fa-paper-plane me-1"></i> Gửi đơn',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#0ea5e9',
                didOpen: () => {
                    document.getElementById('swal-position').focus();
                },
                preConfirm: () => {
                    const val = document.getElementById('swal-position').value.trim();
                    if (!val) {
                        Swal.showValidationMessage('Vui lòng nhập vị trí!');
                        return false;
                    }
                    return val;
                }
            });

            if (!position) {
                console.log('User cancelled registration');
                return;
            }

            console.log('Submitting registration:', { companyId, position });
            submitRegistration(companyId, position, companyName);
        });
    });
    async function submitRegistration(companyId, position, companyName) {
        try {
            Swal.fire({
                title: 'Đang xử lý...',
                html: 'Vui lòng chờ',
                didOpen: () => Swal.showLoading(),
                allowOutsideClick: false,
                allowEscapeKey: false
            });

            const formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('companyId', companyId);
            formData.append('position', position);

            console.log('Sending POST to /Student/SRegister/SubmitInternal');

            const response = await fetch('/Student/SRegister/SubmitInternal', {
                method: 'POST',
                body: formData
            });

            console.log('Response status:', response.status);
            console.log('Response headers:', {
                contentType: response.headers.get('content-type')
            });

            const responseText = await response.text();
            console.log('Response text:', responseText);

            let result;
            try {
                result = JSON.parse(responseText);
            } catch (e) {
                console.error('Failed to parse JSON:', e);
                throw new Error(`Server returned invalid JSON: ${responseText.substring(0, 200)}`);
            }

            console.log('Parsed result:', result);

            Swal.close();

            if (response.ok && result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: result.message,
                    confirmButtonColor: '#0ea5e9'
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Không thể đăng ký',
                    text: result.message || 'Lỗi không xác định',
                    confirmButtonColor: '#0ea5e9'
                });
            }

        } catch (err) {
            console.error('Error:', err);
            Swal.close();
            Swal.fire({
                icon: 'error',
                title: 'Lỗi hệ thống',
                html: `<p>Không thể gửi yêu cầu.</p><p class="text-muted small mt-2">${err.message}</p>`,
                confirmButtonColor: '#0ea5e9'
            });
        }
    }
// ===== ĐĂNG KÝ DOANH NGHIỆP TỰ LIÊN HỆ =====
    const externalForm = document.getElementById('externalForm');
    if (externalForm) {
        externalForm.addEventListener('submit', async function (e) {
            e.preventDefault(); // Chặn hành vi load lại trang mặc định của form

            // Lấy dữ liệu từ form
            const formData = new FormData(this);
            // FormData đã tự động bao gồm __RequestVerificationToken từ @Html.AntiForgeryToken()
            
            // Validate các trường bắt buộc
            const companyName = formData.get('CompanyName')?.trim();
            const address = formData.get('Address')?.trim();
            const contactPerson = formData.get('ContactPerson')?.trim();
            const phone = formData.get('Phone')?.trim();
            const email = formData.get('Email')?.trim();
            const position = formData.get('Position')?.trim();
            
            if (!companyName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng nhập tên công ty.',
                    confirmButtonColor: '#0ea5e9'
                });
                return;
            }
            
            if (!address) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng nhập địa chỉ công ty.',
                    confirmButtonColor: '#0ea5e9'
                });
                return;
            }
            
            if (!contactPerson) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng nhập tên người liên hệ.',
                    confirmButtonColor: '#0ea5e9'
                });
                return;
            }
            
            if (!phone) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng nhập số điện thoại người liên hệ.',
                    confirmButtonColor: '#0ea5e9'
                });
                return;
            }
            
            if (!email) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng nhập email người liên hệ.',
                    confirmButtonColor: '#0ea5e9'
                });
                return;
            }
            
            if (!position) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Thiếu thông tin',
                    text: 'Vui lòng nhập vị trí thực tập.',
                    confirmButtonColor: '#0ea5e9'
                });
                return;
            }

            try {
                // Hiển thị loading
                Swal.fire({
                    title: 'Đang xử lý...',
                    html: 'Vui lòng chờ trong giây lát',
                    didOpen: () => Swal.showLoading(),
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });

                console.log('Submitting external form to /Student/SRegister/SubmitExternal');
                console.log('FormData keys:', Array.from(formData.keys()));

                // Gửi request lên server
                const response = await fetch('/Student/SRegister/SubmitExternal', {
                    method: 'POST',
                    body: formData
                });

                console.log('Response status:', response.status);
                const responseText = await response.text();
                console.log('Response text:', responseText);

                let result;
                try {
                    result = JSON.parse(responseText);
                } catch (parseErr) {
                    console.error('Failed to parse JSON response:', parseErr);
                    throw new Error('Server returned invalid response: ' + responseText.substring(0, 200));
                }

                Swal.close();

                if (response.ok && result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: result.message,
                        confirmButtonColor: '#0ea5e9'
                    }).then(() => {
                        location.reload(); // Tải lại trang để cập nhật trạng thái
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Không thể đăng ký',
                        text: result.message || 'Có lỗi xảy ra, vui lòng kiểm tra lại thông tin.',
                        confirmButtonColor: '#0ea5e9'
                    });
                }
            } catch (err) {
                console.error('Error submitting external form:', err);
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi hệ thống',
                    html: `<p>Không thể kết nối đến máy chủ.</p><p class="text-muted small mt-2">${err.message}</p>`,
                    confirmButtonColor: '#0ea5e9'
                });
            }
        });
    }
    // ===== XEM CHI TIẾT DOANH NGHIỆP =====
    document.querySelectorAll('.btn-view-company').forEach(btn => {
        btn.addEventListener('click', function () {
            const name = this.dataset.name || '';
            const address = this.dataset.address || 'Chưa cập nhật';
            const province = this.dataset.province || 'Chưa cập nhật';
            const phone = this.dataset.phone || 'Chưa cập nhật';
            const contact = this.dataset.contact || 'Chưa cập nhật';
            const email = this.dataset.email || 'Chưa cập nhật';

            Swal.fire({
                title: `<i class="fa fa-building text-info me-2"></i>${name}`,
                html: `
                    <div class="text-start small">
                        <div class="row mb-3">
                            <div class="col-5 fw-semibold">Địa chỉ:</div>
                            <div class="col-7 text-muted">${address}</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-5 fw-semibold">Tỉnh/TP:</div>
                            <div class="col-7 text-muted">${province}</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-5 fw-semibold">SĐT:</div>
                            <div class="col-7 text-muted">${phone}</div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-5 fw-semibold">Người liên hệ:</div>
                            <div class="col-7 text-muted">${contact}</div>
                        </div>
                        <div class="row">
                            <div class="col-5 fw-semibold">Email:</div>
                            <div class="col-7 text-muted">${email}</div>
                        </div>
                    </div>
                `,
                width: '550px',
                showCloseButton: true,
                showConfirmButton: false
            });
        });
    });

});
</script>
}